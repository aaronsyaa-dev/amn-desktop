{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Même vérification de types, mais contre la face Business de chaque
    // couture. C'est ce qui empêche la dérive silencieuse : un écran partagé
    // qui se remettrait à importer `RemoteSitesContext` ou `trackerCatalog`
    // directement compile toujours en interne — et casse ici.
    "paths": {
      "@edition/modules": ["src/edition/modules.business.ts"],
      "@edition/ajmani": ["src/edition/ajmani.business.ts"],
      "@edition/navLexique": ["src/edition/navLexique.business.ts"],
      "@edition/cartes": ["src/edition/cartes.business.ts"],
      "@edition/dbSeed": ["src/edition/dbSeed.business.ts"],
      "@edition/changelog": ["src/edition/changelog.business.ts"],
      "@edition/seeds": ["src/edition/seeds.business.ts"],
      "@edition/browserExclusive": ["src/edition/browserExclusive.business.ts"],
      "@edition/exclusive": ["src/edition/exclusive.business.tsx"],
      "@edition/appRoot": ["src/edition/appRoot.business.tsx"],
      "@edition/mainExclusive": ["src/main/exclusive.business.ts"],
      "@edition/preloadExclusive": ["src/preload.exclusive.business.ts"]
    }
  }
}
