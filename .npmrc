# Prevent npm from ever invoking node-gyp for better-sqlite3.
#
# better-sqlite3 ships portable, precompiled N-API prebuilds for every
# platform (node_modules/better-sqlite3/prebuilds/*.node) — no compiler is
# needed to use it. But it declares no explicit "install"/"postinstall"
# script of its own, and npm's own legacy default behavior is: if a package
# has a binding.gyp and no install-related script, silently run
# `node-gyp rebuild` for it on every install. That's exactly what broke the
# Windows release workflow (no Visual Studio on the runner) even though the
# prebuild it needed was already sitting right there in node_modules.
#
# ignore-scripts=true disables ALL lifecycle scripts (ours and every
# dependency's) during npm install/ci/rebuild — the only way to reliably stop
# npm's automatic node-gyp invocation for this one module in any environment.
# The couple of dependencies that DO need their install step (esbuild,
# electron-winstaller) are re-run explicitly and deterministically via the
# "bootstrap" script chained into start/package/make/publish — see
# package.json and README ("Modules natifs & empaquetage").
ignore-scripts=true
