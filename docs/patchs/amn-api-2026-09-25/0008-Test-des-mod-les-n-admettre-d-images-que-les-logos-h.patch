 test/courrier.test.js | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/test/courrier.test.js b/test/courrier.test.js
index fe37b6b..e4c02c8 100644
--- a/test/courrier.test.js
+++ b/test/courrier.test.js
@@ -46,7 +46,11 @@ test('les modèles : chaque nature se rend en FR et en EN, texte et HTML, sans m
   for (const langue of ['fr', 'en']) for (const nature of NATURES) {
     const r = rendre(nature, EXEMPLES[nature], langue);
     assert.ok(r.sujet && r.texte && r.html, `${langue}/${nature}`);
-    assert.doesNotMatch(r.texte, /!/); assert.doesNotMatch(r.html, /#f00|#ff0000|<img|<script/i);
+    assert.doesNotMatch(r.texte, /!/); assert.doesNotMatch(r.html, /#f00|#ff0000|<script/i);
+    // Aucune image, sauf les logos https (avec texte de remplacement) de l'invitation de marque, cahier 43a.
+    const images = r.html.match(/<img\b[^>]*>/gi) ?? [];
+    if (nature === 'invitation') for (const img of images) assert.match(img, /src="https:\/\/[^"]+" [^>]*alt="AMN"/, `${langue}/${nature}`);
+    else assert.equal(images.length, 0, `${langue}/${nature}`);
   }
   assert.throws(() => rendre('lettre', { titre: 'x' }), /désabonnement/);
 });
