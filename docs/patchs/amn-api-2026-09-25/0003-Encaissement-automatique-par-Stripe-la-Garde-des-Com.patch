+/**
+ * L'ENCAISSEMENT, côté routes (chantier « arrivée cliente », partie 3). Voir src/lib/paiements.js.
+ *
+ *   POST /v1/paiements/stripe/webhook            — public, SIGNÉ : Stripe dit ce qui a été payé
+ *                                                   (monté dans server.js AVANT le parseur JSON : la
+ *                                                   signature se vérifie sur les octets reçus)
+ *   GET  /v1/paiements                           — l'état (actif, pourquoi) : équipe AMN DevSec
+ *   GET  /v1/paiements/organisations/:id         — le lien Stripe d'une cliente et ses derniers événements : AMN DevSec
+ *   POST /v1/paiements/organisations/:id/page    — une page de paiement Stripe pour cette cliente : AMN DevSec
+ *   GET  /v1/paiements/abonnement                — mon abonnement : propriétaire ou administratrice cliente
+ *   POST /v1/paiements/abonnement                — souscrire (page Stripe) ou gérer (portail Stripe) : idem
+ */
+import { Router } from 'express';
+import { tenantAuth } from '../middleware/tenantAuth.js';
+import { rateLimit } from '../middleware/rateLimit.js';
+import { AMN_ORG_ID } from '../db/tenancy.js';
+import { appOriginForOrg } from '../lib/links.js';
+import { publicOrigin } from '../lib/origin.js';
+import { creerStore } from '../garde/store.js';
+import { reactiverCompte } from '../garde/gestes.js';
+import { verifierSignature, traiterEvenement, etatPaiements, paiementsActifs, raisonInactive, creerPageDePaiement, creerPortail, clientDe } from '../lib/paiements.js';
+
+/** La Garde des Comptes, qu'elle tourne ou non : un paiement s'enregistre même Garde éteinte (le préavis suivra quand elle battra). */
+const comptes = (req) => ({ store: req.app.locals.garde?.store ?? creerStore(req.app.locals.db), reactiverCompte });
+
+function fondatrice() {
+  const base = tenantAuth({ allowWeb: false, allowSupport: false });
+  return (req, res, next) => base(req, res, (err) => {
+    if (err) return next(err);
+    if (!req.auth?.isFoundingOrg) return res.status(404).json({ error: 'Not found' });
+    return next();
+  });
+}
+
+const horsLigne = (res) => res.status(503).json({ error: 'L’encaissement automatique n’est pas configuré sur ce serveur : les règlements se notent encore à la main.', code: 'paiement_hors_ligne', raison: raisonInactive() });
+
+/** Le webhook : à monter AVANT `express.json`, avec `express.raw`. */
+export function webhookStripe() {
+  return async (req, res) => {
+    const brut = Buffer.isBuffer(req.body) ? req.body : Buffer.from('');
+    const v = verifierSignature(brut, req.get('stripe-signature'));
+    // Sans secret, on ne peut rien vérifier : 503, et Stripe réessaiera une fois la configuration faite.
+    if (v.raison === 'sans_secret') return res.status(503).json({ error: 'webhook non configuré' });
+    // 400 sans détail : on ne dit pas à un inconnu POURQUOI sa signature ne vaut pas.
+    if (!v.ok) return res.status(400).json({ error: 'signature invalide' });
+    let ev;
+    try { ev = JSON.parse(brut.toString('utf8')); } catch { return res.status(400).json({ error: 'corps illisible' }); }
+    try {
+      const r = await traiterEvenement(req.app.locals.db, comptes(req), ev);
+      req.app.locals.hub?.tower?.({ type: 'paiement', effet: r.effet, orgId: r.orgId ?? null });
+      return res.json({ recu: true, effet: r.effet });
+    } catch (err) {
+      // 500 : Stripe réessaiera, et la réservation de l'événement a été rendue.
+      console.error('[paiements] événement non traité', ev?.id, err?.message); // eslint-disable-line no-console
+      return res.status(500).json({ error: 'traitement impossible, réessayez' });
+    }
+  };
+}
+
+export function paiementsRouter() {
+  const router = Router();
+  const db = (req) => req.app.locals.db;
+  const frein = rateLimit({ name: 'paiements', max: 20, windowMs: 15 * 60_000 });
+
+  router.get('/', fondatrice(), (req, res) => res.json({ paiements: etatPaiements() }));
+
+  router.get('/organisations/:id', fondatrice(), async (req, res) => {
+    const org = await db(req).getOrganization(req.params.id);
+    if (!org || org.id === AMN_ORG_ID) return res.status(404).json({ error: 'Organisation introuvable.' });
+    const client = await clientDe(db(req), org.id);
+    const evenements = await db(req).all('SELECT id, type, effet, montant, devise, recu_at FROM paiements_evenements WHERE org_id = ? ORDER BY recu_at DESC LIMIT 20', [org.id]);
+    res.json({ abonnement: client ? { relie: Boolean(client.customer_id), statut: client.statut, depuis: client.created_at } : null, evenements });
+  });
+
+  router.post('/organisations/:id/page', fondatrice(), async (req, res) => {
+    if (!paiementsActifs()) return horsLigne(res);
+    const org = await db(req).getOrganization(req.params.id);
+    if (!org || org.id === AMN_ORG_ID) return res.status(404).json({ error: 'Organisation introuvable.' });
+    const proprietaire = (await db(req).listUsers(org.id)).find((u) => u.role === 'owner');
+    try {
+      const page = await creerPageDePaiement(db(req), org, { email: proprietaire?.email ?? null, retour: `${appOriginForOrg(org.id) ?? publicOrigin(req)}/#/parametres` });
+      res.status(201).json(page);
+    } catch (err) { res.status(err.status ?? 500).json({ error: err.message, code: err.code ?? null }); }
+  });
+
+  const cliente = tenantAuth({ allowWeb: false, allowSupport: false, roles: ['owner', 'admin'] });
+
+  router.get('/abonnement', cliente, async (req, res) => {
+    if (req.auth.isFoundingOrg) return res.status(404).json({ error: 'Not found' });
+    const client = await clientDe(db(req), req.auth.orgId);
+    res.json({ actif: paiementsActifs(), abonnement: client ? { relie: Boolean(client.customer_id), statut: client.statut } : null });
+  });
+
+  router.post('/abonnement', frein, cliente, async (req, res) => {
+    if (req.auth.isFoundingOrg) return res.status(404).json({ error: 'Not found' });
+    if (!paiementsActifs()) return horsLigne(res);
+    const org = await db(req).getOrganization(req.auth.orgId);
+    const retour = `${appOriginForOrg(org.id) ?? publicOrigin(req)}/#/parametres`;
+    try {
+      const client = await clientDe(db(req), org.id);
+      if (client?.customer_id) return res.json({ ...(await creerPortail(db(req), org.id, { retour })), nature: 'portail' });
+      const user = await db(req).getUser(req.auth.userId);
+      return res.status(201).json({ ...(await creerPageDePaiement(db(req), org, { email: user?.email ?? null, retour })), nature: 'souscription' });
+    } catch (err) { return res.status(err.status ?? 500).json({ error: err.message, code: err.code ?? null }); }
+  });
+
+  return router;
+}
