@@ -0,0 +1,280 @@
+/**
+ * L'ENCAISSEMENT AUTOMATIQUE — Stripe (chantier « arrivée cliente », partie 3).
+ *
+ * Avant : un règlement se notait à la main (`POST /v1/garde/comptes/:orgId/paiement`,
+ * « paye » ou « impaye »). Tout le reste — préavis, sept jours de grâce, mise
+ * en pause des modules souscrits, réouverture — était déjà automatique, mais
+ * attendait qu'un humain dise ce qui avait été payé.
+ *
+ * Maintenant : Stripe dit ce qui a été payé. Une cliente souscrit par une page
+ * de paiement Stripe (Checkout) ; chaque facture réglée ou échouée arrive ici
+ * en événement SIGNÉ, et la Garde des Comptes agit sur ce vrai statut :
+ *
+ *   invoice.paid                 → à jour (et, si elle était en impayé, réouverture)
+ *   invoice.payment_failed       → impayé (préavis à la prochaine ronde, grâce, pause)
+ *   checkout.session.completed   → la cliente est reliée à son client Stripe
+ *   customer.subscription.deleted→ remonté à Harun : on ne suspend pas sur une résiliation
+ *
+ * Ce qui est tenu, et testé (test/paiements.test.js) :
+ *   - la SIGNATURE : HMAC-SHA256 sur le corps brut, tolérance de 5 minutes,
+ *     comparaison à temps constant — un événement non signé ne fait rien ;
+ *   - l'IDEMPOTENCE : un événement ne se traite qu'une fois (Stripe en rejoue) ;
+ *   - l'ORDRE : Stripe ne garantit pas l'ordre ; un événement plus ancien que
+ *     le dernier qui a changé l'état d'une cliente est noté, sans effet ;
+ *   - la GRÂCE : un nouvel échec pendant le préavis ou la grâce ne remet pas le
+ *     compteur à zéro ;
+ *   - SANS CLÉ : rien ne change, le flux manuel reste, et l'interface le dit.
+ *
+ * Pas de SDK : l'API Stripe se parle en formulaire HTTP, comme Resend en JSON
+ * (src/lib/courrier.js). `fetchImpl` s'injecte pour les tests.
+ */
+import crypto from 'node:crypto';
+import { AMN_ORG_ID } from '../db/tenancy.js';
+
+const API = 'https://api.stripe.com/v1';
+const TOLERANCE_S = 300;
+
+let etat = {
+  cle: null,
+  secretWebhook: null,
+  prix: {},
+  quantite: 'forfait',
+  fetchImpl: globalThis.fetch,
+  horloge: () => Date.now(),
+};
+
+/**
+ * `prix` : l'identifiant de prix Stripe par formule (`business_standard`,
+ * `business_premium`). `quantite` : « forfait » (une unité par abonnement) ou
+ * « places » (une unité par place de la formule).
+ */
+export function configurerPaiements({ cle = null, secretWebhook = null, prix = {}, quantite = 'forfait', fetchImpl = globalThis.fetch, horloge = () => Date.now() } = {}) {
+  etat = { cle: cle || null, secretWebhook: secretWebhook || null, prix: Object.fromEntries(Object.entries(prix ?? {}).filter(([, v]) => v)), quantite: quantite === 'places' ? 'places' : 'forfait', fetchImpl, horloge };
+  return paiementsActifs();
+}
+export const paiementsActifs = () => Boolean(etat.cle && etat.secretWebhook && Object.keys(etat.prix).length > 0);
+export const raisonInactive = () => (!etat.cle ? 'sans_cle' : !etat.secretWebhook ? 'sans_secret_webhook' : Object.keys(etat.prix).length === 0 ? 'sans_prix' : null);
+export function etatPaiements() {
+  return { actif: paiementsActifs(), raison: raisonInactive(), fournisseur: 'stripe', formules: Object.keys(etat.prix), quantite: etat.quantite, modeTest: Boolean(etat.cle?.startsWith('sk_test_')) };
+}
+
+export async function ensurePaiementsSchema(db) {
+  // La cliente et son client Stripe. `derniere_bascule_at` : l'horodatage Stripe du dernier événement qui a changé son état.
+  await db.run(`CREATE TABLE IF NOT EXISTS paiements_clients (
+    org_id TEXT PRIMARY KEY, customer_id TEXT UNIQUE, subscription_id TEXT, statut TEXT,
+    derniere_bascule_at INTEGER, created_at TEXT NOT NULL, updated_at TEXT NOT NULL)`);
+  // Chaque événement reçu, une fois : l'idempotence et la trace (sans carte, sans adresse).
+  await db.run(`CREATE TABLE IF NOT EXISTS paiements_evenements (
+    id TEXT PRIMARY KEY, type TEXT NOT NULL, org_id TEXT, objet_id TEXT, montant INTEGER, devise TEXT,
+    cree_stripe INTEGER, effet TEXT, recu_at TEXT NOT NULL)`);
+  await db.run('CREATE INDEX IF NOT EXISTS paiements_evenements_org_idx ON paiements_evenements (org_id, recu_at)');
+}
+
+const nowIso = () => new Date(etat.horloge()).toISOString();
+
+/* ─────────────────────────── La signature ─────────────────────────── */
+
+/**
+ * Vérifie l'en-tête `Stripe-Signature` (`t=…,v1=…[,v1=…]`) sur le corps BRUT.
+ * Rend `{ ok: true }` ou `{ ok: false, raison }`. Aucune exception.
+ */
+export function verifierSignature(corpsBrut, entete, secret = etat.secretWebhook, maintenantMs = etat.horloge(), toleranceS = TOLERANCE_S) {
+  if (!secret) return { ok: false, raison: 'sans_secret' };
+  if (!entete || typeof entete !== 'string') return { ok: false, raison: 'sans_signature' };
+  const morceaux = entete.split(',').map((p) => p.trim().split('='));
+  const t = Number(morceaux.find(([k]) => k === 't')?.[1]);
+  const signatures = morceaux.filter(([k]) => k === 'v1').map(([, v]) => v).filter(Boolean);
+  if (!Number.isFinite(t) || signatures.length === 0) return { ok: false, raison: 'signature_illisible' };
+  if (Math.abs(maintenantMs / 1000 - t) > toleranceS) return { ok: false, raison: 'hors_delai' };
+  const attendue = crypto.createHmac('sha256', secret).update(`${t}.`).update(Buffer.isBuffer(corpsBrut) ? corpsBrut : Buffer.from(String(corpsBrut ?? ''))).digest();
+  for (const s of signatures) {
+    const recue = Buffer.from(s, 'hex');
+    if (recue.length === attendue.length && crypto.timingSafeEqual(recue, attendue)) return { ok: true, t };
+  }
+  return { ok: false, raison: 'signature_fausse' };
+}
+
+/** Pour les tests et le contrôle : l'en-tête que Stripe poserait sur ce corps. */
+export function signer(corpsBrut, secret, tSecondes) {
+  const sig = crypto.createHmac('sha256', secret).update(`${tSecondes}.${corpsBrut}`).digest('hex');
+  return `t=${tSecondes},v1=${sig}`;
+}
+
+/* ─────────────────────────── L'API Stripe ─────────────────────────── */
+
+/** `{ a: { b: [ { c: 1 } ] } }` → `a[b][0][c]=1` : le format de formulaire de Stripe. */
+function formulaire(obj, prefixe = '', sortie = new URLSearchParams()) {
+  for (const [k, v] of Object.entries(obj)) {
+    if (v === undefined || v === null) continue;
+    const cle = prefixe ? `${prefixe}[${k}]` : k;
+    if (typeof v === 'object') formulaire(v, cle, sortie);
+    else sortie.append(cle, String(v));
+  }
+  return sortie;
+}
+
+async function stripe(chemin, params, { idempotence = null } = {}) {
+  if (!etat.cle) throw Object.assign(new Error('Paiement hors ligne : STRIPE_SECRET_KEY absente.'), { status: 503, code: 'paiement_hors_ligne' });
+  const r = await etat.fetchImpl(`${API}${chemin}`, {
+    method: 'POST',
+    headers: { authorization: `Bearer ${etat.cle}`, 'content-type': 'application/x-www-form-urlencoded', ...(idempotence ? { 'idempotency-key': idempotence } : {}) },
+    body: formulaire(params).toString(),
+  });
+  const json = await r.json().catch(() => ({}));
+  if (!r.ok) throw Object.assign(new Error(json?.error?.message ?? `Stripe HTTP ${r.status}`), { status: 502, code: 'stripe' });
+  return json;
+}
+
+export async function clientDe(db, orgId) {
+  return (await db.all('SELECT * FROM paiements_clients WHERE org_id = ?', [orgId]))[0] ?? null;
+}
+async function orgDuClient(db, customerId) {
+  if (!customerId) return null;
+  return (await db.all('SELECT org_id FROM paiements_clients WHERE customer_id = ?', [customerId]))[0]?.org_id ?? null;
+}
+async function relier(db, orgId, { customerId = null, subscriptionId = null, statut = null } = {}) {
+  const existant = await clientDe(db, orgId);
+  const at = nowIso();
+  if (!existant) {
+    await db.run('INSERT INTO paiements_clients (org_id, customer_id, subscription_id, statut, derniere_bascule_at, created_at, updated_at) VALUES (?, ?, ?, ?, NULL, ?, ?)', [orgId, customerId, subscriptionId, statut, at, at]);
+  } else {
+    await db.run('UPDATE paiements_clients SET customer_id = COALESCE(?, customer_id), subscription_id = COALESCE(?, subscription_id), statut = COALESCE(?, statut), updated_at = ? WHERE org_id = ?', [customerId, subscriptionId, statut, at, orgId]);
+  }
+}
+
+/**
+ * La page de paiement Stripe pour une organisation cliente : un abonnement à
+ * sa formule. Rend `{ url }`. La cliente paie chez Stripe — la carte ou le
+ * mandat SEPA ne passent jamais par nos serveurs.
+ */
+export async function creerPageDePaiement(db, org, { email = null, retour }) {
+  if (!org || org.id === AMN_ORG_ID || org.plan === 'internal') throw Object.assign(new Error('Organisation cliente attendue.'), { status: 400 });
+  const prix = etat.prix[org.plan];
+  if (!prix) throw Object.assign(new Error(`Aucun prix Stripe configuré pour la formule ${org.plan}.`), { status: 503, code: 'sans_prix' });
+  const deja = await clientDe(db, org.id);
+  const quantite = etat.quantite === 'places' ? Math.max(1, Number(org.seats) || 1) : 1;
+  const session = await stripe('/checkout/sessions', {
+    mode: 'subscription',
+    line_items: [{ price: prix, quantity: quantite }],
+    success_url: `${retour}?paiement=ok`,
+    cancel_url: `${retour}?paiement=annule`,
+    client_reference_id: org.id,
+    ...(deja?.customer_id ? { customer: deja.customer_id } : email ? { customer_email: email } : {}),
+    metadata: { org_id: org.id },
+    subscription_data: { metadata: { org_id: org.id } },
+    locale: 'fr',
+  }, { idempotence: `checkout-${org.id}-${crypto.randomUUID()}` });
+  return { url: session.url, id: session.id };
+}
+
+/** Le portail Stripe de la cliente : changer de carte, lire ses factures, résilier. */
+export async function creerPortail(db, orgId, { retour }) {
+  const c = await clientDe(db, orgId);
+  if (!c?.customer_id) throw Object.assign(new Error('Aucun abonnement pour cette organisation : souscrivez d’abord.'), { status: 404, code: 'sans_abonnement' });
+  const session = await stripe('/billing_portal/sessions', { customer: c.customer_id, return_url: retour });
+  return { url: session.url };
+}
+
+/* ─────────────────────────── Les événements ─────────────────────────── */
+
+const orgDesMetadonnees = (o) => o?.metadata?.org_id
+  ?? o?.subscription_details?.metadata?.org_id
+  ?? o?.parent?.subscription_details?.metadata?.org_id
+  ?? o?.lines?.data?.[0]?.metadata?.org_id
+  ?? null;
+
+/**
+ * Traite un événement Stripe DÉJÀ VÉRIFIÉ. `garde` porte le store et les gestes
+ * de la Garde des Comptes. Rend `{ effet }` — ce qui a été fait, en un mot.
+ */
+export async function traiterEvenement(db, garde, ev) {
+  if (!ev?.id || !ev?.type) return { effet: 'illisible' };
+  const o = ev.data?.object ?? {};
+  /*
+    RÉSERVER AVANT DE TRAITER. Stripe rejoue un événement tant qu'il n'a pas
+    reçu 2xx — et peut le faire pendant que le premier envoi est encore en
+    cours. L'insertion est atomique : une seule livraison obtient la ligne, les
+    autres voient « déjà traité » et ne touchent à rien.
+  */
+  const montantBrut = o.amount_paid ?? o.amount_due ?? o.amount_total;
+  const reserve = await db.run('INSERT INTO paiements_evenements (id, type, org_id, objet_id, montant, devise, cree_stripe, effet, recu_at) VALUES (?, ?, NULL, ?, ?, ?, ?, ?, ?) ON CONFLICT (id) DO NOTHING', [ev.id, ev.type, o.id ?? null, Number.isFinite(montantBrut) ? montantBrut : null, o.currency ?? null, Number(ev.created) || null, 'en_cours', nowIso()]);
+  if (!reserve?.changes) {
+    const precedent = (await db.all('SELECT effet FROM paiements_evenements WHERE id = ?', [ev.id]))[0]?.effet ?? null;
+    return { effet: 'deja_traite', precedent };
+  }
+  const noter = async (effet, orgId = null) => {
+    await db.run('UPDATE paiements_evenements SET effet = ?, org_id = ? WHERE id = ?', [effet, orgId, ev.id]);
+    return { effet, orgId };
+  };
+  try {
+    return await appliquer(db, garde, ev, o, noter);
+  } catch (err) {
+    // Échec en cours de route : la réservation est rendue, pour que la relance de Stripe refasse le travail.
+    await db.run("DELETE FROM paiements_evenements WHERE id = ? AND effet = 'en_cours'", [ev.id]).catch(() => undefined);
+    throw err;
+  }
+}
+
+async function appliquer(db, garde, ev, o, noter) {
+
+  let orgId = null;
+  if (ev.type === 'checkout.session.completed') orgId = o.client_reference_id ?? orgDesMetadonnees(o);
+  else orgId = (await orgDuClient(db, o.customer)) ?? orgDesMetadonnees(o);
+  const org = orgId ? await db.getOrganization(orgId) : null;
+  if (!org || org.id === AMN_ORG_ID) return noter('organisation_inconnue', null);
+
+  // L'ordre : un événement plus ancien que la dernière bascule de cette cliente ne rebascule rien.
+  const client = await clientDe(db, org.id);
+  const cree = Number(ev.created) || 0;
+  const bascule = ['invoice.paid', 'invoice.payment_succeeded', 'invoice.payment_failed'].includes(ev.type);
+  if (bascule && client?.derniere_bascule_at && cree < Number(client.derniere_bascule_at)) return noter('ancien_ignore', org.id);
+  const poserBascule = () => db.run('UPDATE paiements_clients SET derniere_bascule_at = ?, updated_at = ? WHERE org_id = ?', [cree, nowIso(), org.id]);
+
+  const { store, reactiverCompte } = garde;
+  const journal = (action, pourquoi, detail = null) => store.ecrireJournal({ agent: 'comptes.impayes', equipe: 'comptes', orgId: org.id, action, pourquoi, resultat: 'regle', detail: { stripe: ev.id, ...(detail ?? {}) } });
+  const montant = (n, devise) => (Number.isFinite(n) ? `${(n / 100).toFixed(2).replace('.', ',')} ${String(devise ?? 'eur').toUpperCase()}` : '');
+
+  switch (ev.type) {
+    case 'checkout.session.completed': {
+      await relier(db, org.id, { customerId: o.customer ?? null, subscriptionId: o.subscription ?? null, statut: 'actif' });
+      await journal('abonnement', `${org.name} a souscrit son abonnement par Stripe`);
+      return noter('relie', org.id);
+    }
+    case 'invoice.paid':
+    case 'invoice.payment_succeeded': {
+      await relier(db, org.id, { customerId: o.customer ?? null, statut: 'actif' });
+      await poserBascule();
+      const compte = await store.getCompte(org.id);
+      if (compte && compte.etat !== 'a_jour') {
+        await reactiverCompte({ db, hub: null, store }, org.id, { par: 'Stripe' });
+        return noter('reactive', org.id);
+      }
+      await store.upsertCompte(org.id, { etat: 'a_jour' });
+      await journal('paiement-recu', `paiement reçu de ${org.name}${o.amount_paid ? ` : ${montant(o.amount_paid, o.currency)}` : ''}${o.number ? ` (facture ${o.number})` : ''}`, { facture: o.id ?? null });
+      return noter('paye', org.id);
+    }
+    case 'invoice.payment_failed': {
+      await relier(db, org.id, { customerId: o.customer ?? null, statut: 'en_retard' });
+      await poserBascule();
+      const compte = await store.getCompte(org.id);
+      if (compte && ['impaye', 'grace', 'suspendu'].includes(compte.etat)) {
+        // Déjà dans le cycle : un nouvel échec (Stripe retente) ne remet pas la grâce à zéro.
+        await journal('paiement-echoue', `nouvel échec de prélèvement pour ${org.name} ; cycle en cours (${compte.etat}) inchangé`, { tentative: o.attempt_count ?? null });
+        return noter('echec_deja_en_cycle', org.id);
+      }
+      const echeance = o.due_date ? new Date(o.due_date * 1000).toISOString() : o.period_end ? new Date(o.period_end * 1000).toISOString() : nowIso();
+      await store.upsertCompte(org.id, { etat: 'impaye', echeanceAt: echeance, impayeDepuis: nowIso(), note: `Stripe : échec de paiement${o.number ? ` (facture ${o.number})` : ''}` });
+      await journal('impaye', `Stripe signale un paiement échoué pour ${org.name}${o.amount_due ? ` : ${montant(o.amount_due, o.currency)}` : ''} ; préavis à la prochaine ronde`, { tentative: o.attempt_count ?? null });
+      return noter('impaye', org.id);
+    }
+    case 'customer.subscription.deleted': {
+      await relier(db, org.id, { statut: 'resilie' });
+      // Une résiliation n'est pas un impayé : une personne décide.
+      await store.upsertRemontee({ cle: `resiliation:${org.id}`, agent: 'comptes.impayes', equipe: 'comptes', orgId: org.id, gravite: 'haute', titre: `${org.name} a résilié son abonnement Stripe.`, contexte: 'Aucun module n’a été fermé : une résiliation se traite avec la cliente, pas par la Garde.', options: ['appeler la cliente', 'fermer les modules souscrits', 'laisser ouvert'], recommandation: 'Appeler la cliente avant toute fermeture.' });
+      await journal('resiliation', `${org.name} a résilié son abonnement ; remonté à Harun, rien n’est fermé`);
+      return noter('resiliation_remontee', org.id);
+    }
+    default:
+      return noter('ignore', org.id);
+  }
+}
