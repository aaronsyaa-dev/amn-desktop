+  // Stripe encaisse : tout rouvre, sans personne.
+  assert.equal((await livrer('invoice.paid', facture(org), { created: 3000 })).body.effet, 'reactive');
+  assert.equal((await garde.store.getCompte(org.id)).etat, 'a_jour');
+  assert.ok((await db.getOrganization(org.id)).modulesAdded.includes(souscrit), 'module rouvert');
+  assert.ok((await db.listRecords(org.id, 'announcements')).some((a) => a.data.title === 'Règlement reçu'));
+});
+
+test('un paiement mensuel sur un compte à jour : une ligne « paiement reçu », ni annonce ni réactivation', async (t) => {
+  const { db, garde, org, livrer } = await decor(t);
