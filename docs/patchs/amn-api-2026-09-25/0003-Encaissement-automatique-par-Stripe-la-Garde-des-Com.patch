+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import http from 'node:http';
+
+process.env.NODE_ENV = 'test';
+process.env.OPERATOR_TOKEN = 'test-operator-token';
+
+const { createApp } = await import('../src/server.js');
+const { createSqliteDb } = await import('../src/db/sqlite.js');
+const { AMN_ORG_ID, ORG_MODULES, formulaModules, effectiveModules } = await import('../src/db/tenancy.js');
+const { hashPassword } = await import('../src/lib/password.js');
+const { creerGarde } = await import('../src/garde/index.js');
+const { configurerPaiements, signer, verifierSignature } = await import('../src/lib/paiements.js');
+
+/**
+ * L'ENCAISSEMENT AUTOMATIQUE (chantier « arrivée cliente », partie 3).
+ *
+ * Stripe dit ce qui a été payé ; la Garde des Comptes agit sur ce vrai statut —
+ * préavis, grâce, pause, réouverture — sans qu'un humain note le règlement.
+ * Stripe est simulé (fetchImpl) ; les SIGNATURES, elles, sont réelles.
+ */
+const OPERATOR = 'test-operator-token';
+const SECRET = 'whsec_test_secret_de_signature';
+const MDP = 'motdepasse-solide';
+const jour = 86_400_000;
+
+function fauxStripe() {
+  const appels = [];
+  const fetchImpl = async (url, init) => {
+    const corps = new URLSearchParams(init.body);
+    appels.push({ url, corps, entetes: init.headers });
+    if (url.endsWith('/checkout/sessions')) return new Response(JSON.stringify({ id: 'cs_test_1', url: 'https://checkout.stripe.com/c/pay/cs_test_1' }), { status: 200 });
+    if (url.endsWith('/billing_portal/sessions')) return new Response(JSON.stringify({ id: 'bps_1', url: 'https://billing.stripe.com/p/session/bps_1' }), { status: 200 });
+    return new Response(JSON.stringify({ error: { message: 'inconnu' } }), { status: 404 });
+  };
+  return { appels, fetchImpl };
+}
+
+async function decor(t, { configurer = true } = {}) {
+  const stripe = fauxStripe();
+  if (configurer) configurerPaiements({ cle: 'sk_test_cle', secretWebhook: SECRET, prix: { business_standard: 'price_standard', business_premium: 'price_premium' }, fetchImpl: stripe.fetchImpl });
+  else configurerPaiements({});
+  const db = createSqliteDb(':memory:');
+  await db.init();
+  const hash = await hashPassword(MDP);
+  await db.createUser({ orgId: AMN_ORG_ID, email: 'aaron@amn-test.local', passwordHash: hash, role: 'owner', status: 'active' });
+  const org = await db.createOrganization({ name: 'Fleurs de Lune', plan: 'business_standard' });
+  // Un module SOUSCRIT en plus de la formule : c'est lui que l'impayé met en pause.
+  const souscrit = ORG_MODULES.find((k) => !formulaModules('business_standard').includes(k));
+  await db.updateOrganization(org.id, { modules: effectiveModules('business_standard', { added: [souscrit], removed: [] }), modulesAdded: [souscrit], modulesRemoved: [] });
+  await db.createUser({ orgId: org.id, email: 'medina@fleurs.test', passwordHash: hash, role: 'owner', status: 'active' });
+  await db.createUser({ orgId: org.id, email: 'yanis@fleurs.test', passwordHash: hash, role: 'member', status: 'active' });
+  const app = await createApp({ db });
+  const garde = creerGarde({ db, hub: null });
+  await garde.demarrer();
+  garde.arreter();
+  app.locals.garde = garde;
+  const server = http.createServer(app);
+  await new Promise((r) => server.listen(0, r));
+  const base = `http://127.0.0.1:${server.address().port}`;
+  t.after(async () => { configurerPaiements({}); server.closeAllConnections?.(); await new Promise((r) => server.close(r)); await db.close(); });
+  const api = async (path, { token, method = 'GET', body } = {}) => {
+    const r = await fetch(`${base}${path}`, { method, headers: { 'Content-Type': 'application/json', ...(token ? { Authorization: `Bearer ${token}` } : {}) }, body: body === undefined ? undefined : JSON.stringify(body) });
+    return { status: r.status, body: await r.json().catch(() => null) };
+  };
+  const login = async (email) => (await api('/v1/auth/login', { method: 'POST', body: { email, password: MDP } })).body.token;
+  let n = 0;
+  /** Livre un événement comme Stripe : corps brut, en-tête signé. */
+  const livrer = async (type, objet, { created = Math.floor(Date.now() / 1000), id = `evt_${(n += 1)}`, secret = SECRET, t: tSig = Math.floor(Date.now() / 1000), alterer = null, entete } = {}) => {
+    const corps = JSON.stringify({ id, type, created, data: { object: objet } });
+    const envoye = alterer ? alterer(corps) : corps;
+    const r = await fetch(`${base}/v1/paiements/stripe/webhook`, { method: 'POST', headers: { 'Content-Type': 'application/json', 'Stripe-Signature': entete ?? signer(corps, secret, tSig) }, body: envoye });
+    return { status: r.status, body: await r.json().catch(() => null), id };
+  };
+  return { db, garde, org, souscrit, api, login, livrer, stripe };
+}
+
+const facture = (org, extra = {}) => ({ id: 'in_1', object: 'invoice', customer: 'cus_fleurs', amount_paid: 4900, amount_due: 4900, currency: 'eur', number: 'FL-0001', subscription_details: { metadata: { org_id: org.id } }, ...extra });
+
+test('la signature : juste, elle passe ; fausse, périmée, absente ou sur un corps modifié, rien ne se passe', async (t) => {
+  const { db, org, livrer } = await decor(t);
+  const vieux = Math.floor(Date.now() / 1000) - 600;
+  assert.equal((await livrer('invoice.payment_failed', facture(org), { secret: 'whsec_autre' })).status, 400);
+  assert.equal((await livrer('invoice.payment_failed', facture(org), { t: vieux, created: vieux })).status, 400, 'rejouée plus de 5 minutes après');
+  assert.equal((await livrer('invoice.payment_failed', facture(org), { entete: '' })).status, 400);
+  assert.equal((await livrer('invoice.payment_failed', facture(org), { alterer: (c) => c.replace('4900', '1') })).status, 400);
+  assert.equal((await db.all('SELECT * FROM garde_comptes')).length, 0, 'aucun compte touché');
+  assert.equal((await db.all('SELECT * FROM paiements_evenements')).length, 0, 'aucun événement retenu');
+  assert.equal((await livrer('invoice.payment_failed', facture(org))).status, 200);
+});
+
+test('vérification seule : deux signatures v1 (rotation du secret), l’une bonne, suffit ; le temps se compare en secondes', () => {
+  const corps = '{"id":"evt_x"}';
+  const t0 = 1_800_000_000;
+  const bonne = signer(corps, SECRET, t0).split(',')[1];
+  assert.equal(verifierSignature(corps, `t=${t0},v1=${'0'.repeat(64)},${bonne}`, SECRET, t0 * 1000).ok, true);
+  assert.equal(verifierSignature(corps, `t=${t0},v1=${'0'.repeat(64)}`, SECRET, t0 * 1000).raison, 'signature_fausse');
+  assert.equal(verifierSignature(corps, `t=${t0},${bonne}`, SECRET, (t0 + 301) * 1000).raison, 'hors_delai');
+  assert.equal(verifierSignature(corps, 'n’importe quoi', SECRET, t0 * 1000).raison, 'signature_illisible');
+});
+
+test('sans configuration : le webhook répond 503 (Stripe réessaiera) et les pages de paiement disent « hors ligne »', async (t) => {
+  const { org, livrer, api, login } = await decor(t, { configurer: false });
+  assert.equal((await livrer('invoice.paid', facture(org))).status, 503);
+  const r = await api(`/v1/paiements/organisations/${org.id}/page`, { token: OPERATOR, method: 'POST' });
+  assert.equal(r.status, 503);
+  assert.equal(r.body.code, 'paiement_hors_ligne');
+  const medina = await login('medina@fleurs.test');
+  assert.equal((await api('/v1/paiements/abonnement', { token: medina, method: 'POST' })).body.code, 'paiement_hors_ligne');
+});
+
+test('le cycle complet sur le VRAI statut : échec → préavis → grâce → pause ; paiement → réouverture, sans saisie humaine', async (t) => {
+  const { db, garde, org, souscrit, livrer } = await decor(t);
+  assert.equal((await livrer('invoice.payment_failed', facture(org), { created: 1000 })).body.effet, 'impaye');
+  assert.equal((await garde.store.getCompte(org.id)).etat, 'impaye');
+
+  await garde.lancerRonde('comptes.impayes', Date.now(), { force: true });
+  const enGrace = await garde.store.getCompte(org.id);
+  assert.equal(enGrace.etat, 'grace');
