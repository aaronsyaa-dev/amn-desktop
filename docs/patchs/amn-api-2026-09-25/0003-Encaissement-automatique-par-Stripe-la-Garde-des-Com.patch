+  assert.equal((await garde.store.getCompte(org.id)).graceJusqua, enGrace.graceJusqua);
+
+  // Grâce échue : pause des modules souscrits, données intactes.
+  await garde.lancerRonde('comptes.impayes', Date.now() + 8 * jour, { force: true });
+  assert.equal((await garde.store.getCompte(org.id)).etat, 'suspendu');
+  assert.ok(!(await db.getOrganization(org.id)).modulesAdded.includes(souscrit), 'module souscrit en pause');
