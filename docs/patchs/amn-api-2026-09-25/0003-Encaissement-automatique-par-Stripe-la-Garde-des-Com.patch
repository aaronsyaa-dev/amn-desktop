+
+test('la page de paiement : Harun l’ouvre pour une cliente — prix de sa formule, cliente référencée, métadonnées posées', async (t) => {
+  const { org, api, stripe, livrer, login } = await decor(t);
+  const r = await api(`/v1/paiements/organisations/${org.id}/page`, { token: OPERATOR, method: 'POST' });
+  assert.equal(r.status, 201, JSON.stringify(r.body));
+  assert.match(r.body.url, /^https:\/\/checkout\.stripe\.com\//);
+  const { corps, entetes } = stripe.appels.at(-1);
+  assert.equal(corps.get('mode'), 'subscription');
+  assert.equal(corps.get('line_items[0][price]'), 'price_standard');
+  assert.equal(corps.get('client_reference_id'), org.id);
+  assert.equal(corps.get('subscription_data[metadata][org_id]'), org.id);
+  assert.equal(corps.get('customer_email'), 'medina@fleurs.test');
+  assert.equal(entetes.authorization, 'Bearer sk_test_cle');
+  assert.ok(entetes['idempotency-key']);
+
+  // Une cliente ne peut pas ouvrir la page d'une autre.
+  const medina = await login('medina@fleurs.test');
+  assert.equal((await api(`/v1/paiements/organisations/${org.id}/page`, { token: medina, method: 'POST' })).status, 404);
+
+  // Une fois reliée, la cliente gère elle-même : le portail Stripe, pas une nouvelle souscription.
+  await livrer('checkout.session.completed', { id: 'cs_1', client_reference_id: org.id, customer: 'cus_fleurs', subscription: 'sub_1' });
+  const portail = await api('/v1/paiements/abonnement', { token: medina, method: 'POST' });
+  assert.equal(portail.body.nature, 'portail');
+  assert.equal(stripe.appels.at(-1).corps.get('customer'), 'cus_fleurs');
+});
+
+test('libre-service : la propriétaire souscrit elle-même ; un membre ne peut pas ; AMN DevSec n’a pas d’abonnement', async (t) => {
+  const { api, login, stripe } = await decor(t);
+  const medina = await login('medina@fleurs.test');
+  const r = await api('/v1/paiements/abonnement', { token: medina, method: 'POST' });
+  assert.equal(r.status, 201);
+  assert.equal(r.body.nature, 'souscription');
+  assert.equal(stripe.appels.at(-1).corps.get('customer_email'), 'medina@fleurs.test');
+  assert.equal((await api('/v1/paiements/abonnement', { token: await login('yanis@fleurs.test'), method: 'POST' })).status, 403);
+  assert.equal((await api('/v1/paiements/abonnement', { token: OPERATOR, method: 'POST' })).status, 404);
+});
