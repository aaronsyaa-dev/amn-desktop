+/**
+ * L'INVITATION, telle que la personne invitée la voit avant de l'activer.
+ * Utilitaires partagés par les routes qui émettent une invitation
+ * (auth, admin) et celle qui la lit (`POST /v1/auth/invitations/lire`).
+ */
+
+/** « medina@gmail.com » → « m•••••@gmail.com » : assez pour se reconnaître, pas pour être lu par-dessus l'épaule. */
+export function masquerAdresse(email) {
+  const [local, domaine] = String(email ?? '').split('@');
+  if (!local || !domaine) return null;
+  return `${local[0]}${'•'.repeat(Math.max(3, Math.min(local.length - 1, 8)))}@${domaine}`;
+}
+
+/**
+ * Qui invite, tel que la page d'activation le montrera : un nom court, en
+ * clair, sans balise ni caractère de contrôle. Faute de nom fourni, le repli
+ * (le nom de l'organisation qui invite). Jamais une adresse.
+ */
+export function nomInvitant(brut, repli = null) {
+  const nom = String(brut ?? '').replace(/[\u0000-\u001f\u007f<>]/g, '').replace(/\s+/g, ' ').trim().slice(0, 60);
+  if (nom && !nom.includes('@')) return nom;
+  return repli ? String(repli).slice(0, 60) : null;
+}
