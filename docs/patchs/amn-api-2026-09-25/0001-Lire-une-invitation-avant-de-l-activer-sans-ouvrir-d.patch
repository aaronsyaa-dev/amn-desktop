+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import http from 'node:http';
+
+process.env.NODE_ENV = 'test';
+process.env.OPERATOR_TOKEN = 'test-operator-token';
+
+const { createApp } = await import('../src/server.js');
+const { createSqliteDb } = await import('../src/db/sqlite.js');
+const { hashPassword, mintToken } = await import('../src/lib/password.js');
+
+/**
+ * LIRE UNE INVITATION AVANT DE L'ACTIVER (arrivée cliente, tour 43).
+ *
+ * La page d'activation distingue quatre états — valable, expiré, déjà
+ * utilisé, lien incomplet — sans que la route devienne un oracle : tout ce
+ * qui n'est pas un vrai jeton reçoit LA MÊME réponse, compte comme un échec,
+ * et le freinage coupe avant toute lecture, dans le même seau que
+ * l'acceptation.
+ */
+const OPERATOR = 'test-operator-token';
+
+async function decor(t) {
+  const db = createSqliteDb(':memory:');
+  await db.init();
+  const app = await createApp({ db });
+  const server = http.createServer(app);
+  await new Promise((resolve) => server.listen(0, resolve));
+  const { port } = server.address();
+  t.after(async () => {
+    server.closeAllConnections?.();
+    await new Promise((resolve) => server.close(resolve));
+    await db.close();
+  });
+  const base = `http://127.0.0.1:${port}`;
+  const api = async (path, { token, method = 'GET', body, ip } = {}) => {
+    const headers = { 'Content-Type': 'application/json' };
+    if (token) headers.Authorization = `Bearer ${token}`;
+    if (ip) headers['X-Forwarded-For'] = ip;
+    const r = await fetch(`${base}${path}`, { method, headers, body: body === undefined ? undefined : JSON.stringify(body) });
+    let json = null;
+    try { json = await r.json(); } catch { json = null; }
+    return { status: r.status, body: json, headers: r.headers };
+  };
+  const lire = (token, ip) => api('/v1/auth/invitations/lire', { method: 'POST', body: { token }, ip });
+  return { db, api, lire };
+}
+
+async function nouvelleCliente(api, { invitePar } = {}) {
+  const r = await api('/v1/admin/organizations', {
+    token: OPERATOR,
+    method: 'POST',
+    body: { name: 'Fleurs de Lune', plan: 'business_standard', ownerEmail: 'medina@exemple.test', ...(invitePar === undefined ? {} : { invitePar }) },
+  });
+  assert.equal(r.status, 201, JSON.stringify(r.body));
+  return r.body;
+}
+
+test('valable : l’organisation, qui invite, une adresse masquée — et rien de plus', async (t) => {
+  const { api, lire } = await decor(t);
+  const cree = await nouvelleCliente(api, { invitePar: 'Harun' });
+  const r = await lire(cree.invitation.token);
+  assert.equal(r.status, 200);
+  assert.equal(r.headers.get('cache-control'), 'no-store');
+  assert.equal(r.body.etat, 'valable');
+  assert.equal(r.body.nature, 'activation');
+  assert.equal(r.body.organisation.nom, 'Fleurs de Lune');
+  assert.equal(r.body.invitePar, 'Harun');
+  assert.equal(r.body.destinataire, 'm•••••@exemple.test');
+  assert.equal(r.body.motDePasseRequis, true);
+  assert.equal(r.body.expireLe, cree.invitation.expiresAt);
+  const brut = JSON.stringify(r.body);
+  assert.ok(!brut.includes('medina@'), 'l’adresse n’apparaît jamais en clair');
+  assert.ok(!brut.includes(cree.owner.id), 'aucun identifiant de compte');
+  assert.ok(!brut.includes(cree.organization.id), 'aucun identifiant d’organisation');
+  assert.ok(!/token|hash/i.test(Object.keys(r.body).join(' ')), 'ni jeton ni empreinte');
+});
+
+test('sans nom d’invitant fourni, c’est AMN DevSec ; une adresse glissée à la place est refusée', async (t) => {
+  const { api, lire } = await decor(t);
+  const cree = await nouvelleCliente(api, { invitePar: 'harun@amn.test' });
+  assert.equal((await lire(cree.invitation.token)).body.invitePar, 'AMN DevSec');
+});
+
+test('déjà utilisé, puis expiré : deux états distincts, pour le seul porteur d’un vrai jeton', async (t) => {
+  const { db, api, lire } = await decor(t);
+  const cree = await nouvelleCliente(api);
+  const ok = await api('/v1/auth/invitations/accept', { method: 'POST', body: { token: cree.invitation.token, password: 'un-mot-de-passe-solide' } });
+  assert.equal(ok.status, 200);
+  const utilise = await lire(cree.invitation.token);
+  assert.equal(utilise.body.etat, 'utilise');
+  assert.equal(utilise.body.organisation.nom, 'Fleurs de Lune');
+
+  const { plaintext, hash } = mintToken();
+  await db.createInvitation({ tokenHash: hash, userId: cree.owner.id, expiresAt: new Date(Date.now() - 60_000).toISOString(), invitedByName: 'Harun' });
+  const expire = await lire(plaintext);
+  assert.equal(expire.body.etat, 'expire');
+  assert.equal(expire.body.invitePar, 'Harun');
+});
+
+test('lien incomplet : un jeton tronqué, un jeton inconnu et un corps vide rendent EXACTEMENT la même réponse', async (t) => {
+  const { api, lire } = await decor(t);
+  const cree = await nouvelleCliente(api);
+  const tronque = await lire(cree.invitation.token.slice(0, 30), '10.0.0.1');
+  const inconnu = await lire(mintToken().plaintext, '10.0.0.2');
+  const vide = await api('/v1/auth/invitations/lire', { method: 'POST', body: {}, ip: '10.0.0.3' });
+  for (const r of [tronque, inconnu, vide]) {
+    assert.equal(r.status, 200);
+    assert.deepEqual(r.body, { etat: 'incomplet' });
+  }
+});
+
+test('le jeton ne passe jamais par une URL : pas de lecture en GET', async (t) => {
+  const { api } = await decor(t);
+  const r = await api(`/v1/auth/invitations/lire?token=${mintToken().plaintext}`);
+  assert.ok([401, 404].includes(r.status), `refusé (${r.status})`);
+  assert.equal(r.body?.etat, undefined, 'aucune lecture');
+});
+
+test('sonder freine : après 20 jetons au hasard, même un VRAI jeton est refusé (429) — le freinage passe avant la lecture', async (t) => {
+  const { api, lire } = await decor(t);
+  const cree = await nouvelleCliente(api);
+  const ip = '203.0.113.7';
+  for (let i = 0; i < 20; i += 1) assert.deepEqual((await lire(mintToken().plaintext, ip)).body, { etat: 'incomplet' });
+  const bloque = await lire(cree.invitation.token, ip);
+  assert.equal(bloque.status, 429);
+  assert.equal(bloque.body.code, 'too_many_attempts');
+  assert.ok(Number(bloque.headers.get('retry-after')) > 0);
+  assert.equal(bloque.body.organisation, undefined, 'bloqué : rien n’est lu, rien n’est dit');
+  // Une autre adresse n'est pas pénalisée.
+  assert.equal((await lire(cree.invitation.token, '198.51.100.9')).body.etat, 'valable');
+});
+
+test('lire et accepter puisent dans le MÊME seau : alterner les deux routes ne double pas le budget d’essais', async (t) => {
+  const { api, lire } = await decor(t);
+  const cree = await nouvelleCliente(api);
+  const ip = '203.0.113.8';
+  for (let i = 0; i < 10; i += 1) await lire(mintToken().plaintext, ip);
+  for (let i = 0; i < 10; i += 1) {
+    await api('/v1/auth/invitations/accept', { method: 'POST', body: { token: mintToken().plaintext, password: 'peu-importe-ici' }, ip });
+  }
+  assert.equal((await lire(cree.invitation.token, ip)).status, 429);
+  const accepte = await api('/v1/auth/invitations/accept', { method: 'POST', body: { token: cree.invitation.token, password: 'un-mot-de-passe-solide' }, ip });
+  assert.equal(accepte.status, 429);
+});
+
+test('lire ne consomme pas : après lecture, l’invitation s’accepte toujours', async (t) => {
+  const { api, lire } = await decor(t);
+  const cree = await nouvelleCliente(api);
