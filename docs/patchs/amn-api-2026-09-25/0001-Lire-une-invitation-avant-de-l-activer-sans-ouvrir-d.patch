+  /**
+   * LIRE UNE INVITATION AVANT DE L'ACTIVER (arrivée cliente, tour 43).
+   *
+   * La page d'activation a besoin de savoir, AVANT que la personne tape quoi
+   * que ce soit, chez qui elle arrive et si son lien vaut encore. Sans cette
+   * lecture, elle ne pouvait qu'essayer, échouer, et dire « invalide ou
+   * expirée » — sans distinguer un lien périmé (on en redemande un) d'un lien
+   * déjà servi (on se connecte).
+   *
+   * ## Ce qui NE s'affaiblit PAS : la protection contre le sondage
+   *
+   * Sonder, c'est essayer des jetons au hasard pour apprendre quelque chose.
+   * Trois verrous, les mêmes qu'à l'acceptation :
+   *
+   *   1. Le FREINAGE AVANT toute lecture — mêmes seaux par adresse que
+   *      `/invitations/accept` (20 échecs par 15 min, puis 429). Lire et
+   *      accepter puisent dans le MÊME seau : on ne double pas le budget
+   *      d'essais en alternant les deux routes.
+   *   2. UNE SEULE RÉPONSE pour tout ce qui n'est pas un vrai jeton — mal
+   *      formé (lien tronqué par une messagerie) ou inconnu : `{ etat:
+   *      'incomplet' }`, toujours 200, toujours compté comme un échec. Qui
+   *      tape au hasard ne voit jamais que cela, et se fait freiner.
+   *   3. L'ENTROPIE : un jeton fait 256 bits. Les états distincts (valable,
+   *      expiré, déjà utilisé) ne se voient qu'avec un vrai jeton — c'est-à-
+   *      dire en tenant déjà le lien reçu. Ce que ce porteur apprend (le nom
+   *      de l'organisation, qui invite, une adresse MASQUÉE) est ce que le
+   *      courriel lui a déjà dit.
+   *
+   * Le jeton voyage dans le CORPS d'un POST, jamais dans une URL : une URL
+   * finit dans les journaux d'accès, les en-têtes Referer et l'historique.
+   * La réponse n'est jamais mise en cache.
+   */
+  router.post('/invitations/lire', async (req, res) => {
+    const db = req.app.locals.db;
+    const token = String(req.body?.token ?? '').trim();
+    res.set('Cache-Control', 'no-store');
+
+    const seaux = invitationBuckets(req);
+    for (const b of seaux) {
+      const etat = await db.readLoginBucket(b.key);
+      if (etat?.blockedUntil && Date.parse(etat.blockedUntil) > Date.now()) {
+        const secondes = Math.ceil((Date.parse(etat.blockedUntil) - Date.now()) / 1000);
+        res.set('Retry-After', String(secondes));
+        return res.status(429).json({
+          error: 'Trop de tentatives. Réessayez dans quelques minutes.',
+          code: 'too_many_attempts',
+          retryAfterSeconds: secondes,
+        });
+      }
+    }
+    const incomplet = async () => {
+      for (const b of seaux) {
+        await db.bumpLoginBucket({ bucket: b.key, windowMs: LOGIN_WINDOW_MS, threshold: b.threshold, blockMs: LOGIN_BLOCK_MS });
+      }
+      return res.json({ etat: 'incomplet' });
+    };
+
+    if (!FORME_JETON.test(token)) return incomplet();
+    const invitation = await db.findInvitation(hashToken(token));
+    if (!invitation) return incomplet();
+    const user = await db.getUser(invitation.userId);
+    if (!user) return incomplet();
+    const org = await db.getOrganization(invitation.orgId ?? user.orgId);
+    if (!org) return incomplet();
+
+    const etat = invitation.acceptedAt
+      ? 'utilise'
+      : Date.parse(invitation.expiresAt) <= Date.now()
+        ? 'expire'
+        : user.status === 'suspended' || org.status === 'suspended'
+          ? 'suspendu'
+          : 'valable';
+
+    return res.json({
+      etat,
+      nature: invitation.orgId ? 'appartenance' : 'activation',
+      organisation: { nom: org.name, logo: org.logoDataUrl ?? null },
+      invitePar: invitation.invitedByName ?? null,
+      destinataire: masquerAdresse(user.email),
+      emiseLe: invitation.createdAt ?? null,
+      expireLe: invitation.expiresAt,
+      // Une appartenance n'a pas de mot de passe à choisir : le compte en a déjà un.
+      motDePasseRequis: !invitation.orgId,
+    });
+  });
+
