diff --git a/test/garde-attribution.test.js b/test/garde-attribution.test.js
new file mode 100644
index 0000000..271423e
--- /dev/null
+++ b/test/garde-attribution.test.js
@@ -0,0 +1,159 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import http from 'node:http';
+import crypto from 'node:crypto';
+
+process.env.NODE_ENV = 'test';
+process.env.OPERATOR_TOKEN = 'test-operator-token';
+
+const { createApp } = await import('../src/server.js');
+const { createSqliteDb } = await import('../src/db/sqlite.js');
+const { AMN_ORG_ID } = await import('../src/db/tenancy.js');
+const { hashPassword } = await import('../src/lib/password.js');
+const { creerGarde } = await import('../src/garde/index.js');
+
+/**
+ * LA GARDE RANGE SON TRAVAIL CHEZ LA BONNE CLIENTE, ET SON JOURNAL NE DIT QUE
+ * CE QUI CHANGE (chantier « arrivée cliente », partie 4).
+ *
+ * Avant : les sites des clientes appartiennent à AMN DevSec en base, et tout
+ * le travail de la Garde sur eux était rangé sous AMN DevSec ; une situation
+ * retrouvée telle quelle écrivait une ligne de journal à chaque passage.
+ */
+const MDP = 'motdepasse-solide';
+const heure = 3_600_000;
+
+async function decor(t) {
+  const db = createSqliteDb(':memory:');
+  await db.init();
+  const compte = async (orgId, email, role) => db.createUser({ orgId, email, passwordHash: await hashPassword(MDP), role, status: 'active' });
+  await compte(AMN_ORG_ID, 'aaron@amn-test.local', 'owner');
+  const jardin = await db.createOrganization({ name: 'Le Jardin d’Élise', plan: 'business_standard' });
+  const vermeil = await db.createOrganization({ name: 'Atelier Vermeil', plan: 'business_standard' });
+  const halles = await db.createOrganization({ name: 'Les Halles', plan: 'business_standard' });
+  await compte(jardin.id, 'elise@jardin.test', 'owner');
+  const garde = creerGarde({ db, hub: null });
+  await garde.demarrer();
+  garde.arreter();
+  const app = await createApp({ db });
+  app.locals.garde = garde;
+  const server = http.createServer(app);
+  await new Promise((r) => server.listen(0, r));
+  const base = `http://127.0.0.1:${server.address().port}`;
+  t.after(async () => { server.closeAllConnections?.(); await new Promise((r) => server.close(r)); await db.close(); });
+  const login = async (email) => (await (await fetch(`${base}/v1/auth/login`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email, password: MDP }) })).json()).token;
+  const api = (token) => async (path, init = {}) => { const r = await fetch(`${base}${path}`, { ...init, headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}`, ...(init.headers ?? {}) } }); return { status: r.status, body: await r.json().catch(() => null) }; };
+  /** Un site surveillé par AMN DevSec, comme le Parc l'enregistre : il appartient à AMN. */
+  const siteAmn = async (name, { url = null, clientOrgId = null } = {}) => {
+    const site = await db.createSite({ orgId: AMN_ORG_ID, name, apiKeyHash: crypto.randomUUID() });
+    if (url || clientOrgId) await db.updateSite(AMN_ORG_ID, site.id, { ...(url ? { url } : {}), ...(clientOrgId ? { clientOrgId } : {}) });
+    return site;
+  };
+  return { db, garde, jardin, vermeil, halles, login, api, siteAmn };
+}
+
+const lignes = (db, where = '', v = []) => db.all(`SELECT agent, org_id, action, pourquoi FROM garde_journal ${where}`, v);
+
+test('rattachement : seule AMN DevSec rattache un site à une cliente, et jamais à elle-même', async (t) => {
+  const { jardin, login, api, siteAmn } = await decor(t);
+  const aaron = api(await login('aaron@amn-test.local'));
+  const elise = api(await login('elise@jardin.test'));
+  const site = await siteAmn('jardin-elise.fr');
+
+  const ok = await aaron(`/v1/sites/${site.id}`, { method: 'PUT', body: JSON.stringify({ clientOrgId: jardin.id }) });
+  assert.equal(ok.status, 200, JSON.stringify(ok.body));
+  assert.equal(ok.body.site.clientOrgId, jardin.id);
+  assert.equal((await aaron('/v1/sites')).body.sites.find((s) => s.id === site.id).clientOrgId, jardin.id);
+
+  assert.equal((await aaron(`/v1/sites/${site.id}`, { method: 'PUT', body: JSON.stringify({ clientOrgId: AMN_ORG_ID }) })).status, 400);
+  assert.equal((await aaron(`/v1/sites/${site.id}`, { method: 'PUT', body: JSON.stringify({ clientOrgId: crypto.randomUUID() }) })).status, 404);
+
+  // Une cliente, sur SON propre site, ne peut pas ranger son travail ailleurs.
+  const sienne = await elise('/v1/sites', { method: 'POST', body: JSON.stringify({ name: 'boutique', clientOrgId: AMN_ORG_ID }) });
+  assert.equal(sienne.status, 403);
+  const cree = await elise('/v1/sites', { method: 'POST', body: JSON.stringify({ name: 'boutique' }) });
+  assert.equal(cree.status, 201);
+  assert.equal((await elise(`/v1/sites/${cree.body.id}`, { method: 'PUT', body: JSON.stringify({ clientOrgId: jardin.id }) })).status, 403);
+
+  // Le rattachement n'ouvre AUCUN accès : la cliente ne voit pas le site d'AMN.
+  assert.equal((await elise(`/v1/sites/${site.id}/state`)).status, 404);
+  assert.ok(!(await elise('/v1/sites')).body.sites.some((s) => s.id === site.id));
+
+  // `null` détache.
+  const detache = await aaron(`/v1/sites/${site.id}`, { method: 'PUT', body: JSON.stringify({ clientOrgId: null }) });
+  assert.equal(detache.body.site.clientOrgId, null);
+});
+
+test('un site tombé se range chez SA cliente — le nom de la cliente dans le titre, la ligne dans son dossier', async (t) => {
+  const { db, garde, jardin, siteAmn } = await decor(t);
+  const rattache = await siteAmn('jardin-elise.fr', { clientOrgId: jardin.id });
+  const orphelin = await siteAmn('site-sans-cliente.fr');
+  const il_y_a = new Date(Date.now() - 2 * heure).toISOString();
+  for (const s of [rattache, orphelin]) await db.run('UPDATE site_state SET status = ?, updated_at = ?, last_seen_at = ? WHERE site_id = ?', ['offline', il_y_a, il_y_a, s.id]);
+
+  await garde.lancerRonde('sites.disponibilite', Date.now(), { force: true });
+  const rem = await garde.store.listRemontees({ equipe: 'sites' });
+  const chezJardin = rem.find((r) => r.cle === `site-tombe:${rattache.id}`);
+  const chezAmn = rem.find((r) => r.cle === `site-tombe:${orphelin.id}`);
+  assert.equal(chezJardin.orgId, jardin.id, 'rattaché : chez la cliente');
+  assert.match(chezJardin.titre, /Jardin/);
+  assert.equal(chezAmn.orgId, AMN_ORG_ID, 'sans rattachement : chez le propriétaire, comme avant');
+  assert.equal((await lignes(db, 'WHERE org_id = ? AND action = ?', [jardin.id, 'remontee'])).length, 1);
+});
+
+test('le journal ne répète pas : cinq passages sur la même panne, une seule ligne — et le compte de la remontée avance', async (t) => {
+  const { db, garde, jardin, siteAmn } = await decor(t);
+  const site = await siteAmn('jardin-elise.fr', { clientOrgId: jardin.id });
+  const il_y_a = new Date(Date.now() - 2 * heure).toISOString();
+  await db.run('UPDATE site_state SET status = ?, updated_at = ?, last_seen_at = ? WHERE site_id = ?', ['offline', il_y_a, il_y_a, site.id]);
+  for (let i = 0; i < 5; i += 1) await garde.lancerRonde('sites.disponibilite', Date.now() + i * 60_000, { force: true });
+  const remontees = await lignes(db, "WHERE agent = 'sites.disponibilite' AND action IN ('remontee', 'remontee-maj')");
+  assert.equal(remontees.length, 1, remontees.map((l) => l.action).join(', '));
+  const rem = (await garde.store.listRemontees({ equipe: 'sites' })).find((r) => r.cle === `site-tombe:${site.id}`);
+  assert.equal(rem.compte, 5, 'la trace du passage reste, sans bruit');
+});
+
+test('un certificat : la cliente par l’hôte du site ; une gravité qui monte s’écrit, une qui ne bouge pas se tait', async (t) => {
+  const { db, garde, vermeil, siteAmn } = await decor(t);
+  await siteAmn('Atelier Vermeil — vitrine', { url: 'https://atelier-vermeil.fr', clientOrgId: vermeil.id });
+  const poser = (jours) => db.run(
