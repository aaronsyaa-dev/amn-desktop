--- /dev/null
+++ b/src/garde/attribution.js
@@ -0,0 +1,48 @@
+/**
+ * À QUI RANGER LE TRAVAIL DE LA GARDE SUR UN SITE (chantier « arrivée cliente », partie 4).
+ *
+ * Les sites que surveille AMN DevSec lui appartiennent en base — sa clé de
+ * traceur, ses événements, ses incidents restent chez elle, c'est son produit.
+ * Mais chacun est le site D'UNE CLIENTE (`sites.client_org_id`) : ce que la
+ * Garde y fait — une panne remontée, un certificat qui expire, un incident
+ * non pris — se range chez cette cliente. Sans rattachement connu, le travail
+ * reste chez le propriétaire du site, comme avant.
+ *
+ * Mesuré avant : les 9 sites clientes du bac à sable étaient tous sous AMN
+ * DevSec, et le dossier d'aucune cliente ne montrait le travail fait sur son
+ * site (docs/mesures/verite-garde-bac-a-sable-2026-09-24.txt, amn-desktop).
+ *
+ * Un cache par ronde : une ronde lit le même site plusieurs fois.
+ */
+const hoteDe = (url) => {
+  try { return new URL(url).hostname.toLowerCase(); } catch { return null; }
+};
+
+export function creerAttribution(db) {
+  const parSite = new Map();
+  const parProprietaire = new Map();
+  const sitesRattaches = async (orgId) => {
+    if (!parProprietaire.has(orgId)) {
+      parProprietaire.set(orgId, await db.all('SELECT id, name, url, client_org_id FROM sites WHERE org_id = ? AND client_org_id IS NOT NULL', [orgId]));
+    }
+    return parProprietaire.get(orgId);
+  };
+  return {
+    /** L'organisation du travail fait sur ce site : sa cliente, sinon `repli` (le propriétaire). */
+    async duSite(siteId, repli) {
+      if (!siteId) return repli;
+      if (!parSite.has(siteId)) {
+        const r = await db.all('SELECT client_org_id FROM sites WHERE id = ?', [siteId]);
+        parSite.set(siteId, r[0]?.client_org_id ?? null);
+      }
+      return parSite.get(siteId) ?? repli;
+    },
+    /** L'organisation d'un hôte (un certificat) : la cliente du site de ce propriétaire qui porte cet hôte. */
+    async deLHote(proprietaire, hote, repli) {
+      const h = String(hote ?? '').toLowerCase();
+      if (!h) return repli;
+      const trouve = (await sitesRattaches(proprietaire)).find((s) => hoteDe(s.url) === h || String(s.name ?? '').toLowerCase() === h);
+      return trouve?.client_org_id ?? repli;
+    },
+  };
+}
