+ * détacher), `{ absent: true }` si le champ n'est pas envoyé, ou `{ erreur }`.
+ */
+async function lireRattachement(req) {
+  if (!Object.prototype.hasOwnProperty.call(req.body ?? {}, 'clientOrgId')) return { absent: true };
