+  const brut = req.body.clientOrgId;
+  if (brut === null || brut === '') return { valeur: null };
+  const id = String(brut);
+  if (id === AMN_ORG_ID) return { erreur: { status: 400, message: 'Un site se rattache à une cliente, pas à AMN DevSec.' } };
+  const org = await req.app.locals.db.getOrganization(id);
+  if (!org) return { erreur: { status: 404, message: 'Organisation cliente introuvable.' } };
+  return { valeur: org.id };
+}
