+     ON CONFLICT (org_id, host) DO UPDATE SET days_left = excluded.days_left, last_checked_at = excluded.last_checked_at`,
+    [AMN_ORG_ID, 'atelier-vermeil.fr', jours, new Date().toISOString()],
+  );
+  await poser(5);
+  await garde.lancerRonde('sites.certificats', Date.now(), { force: true });
+  await garde.lancerRonde('sites.certificats', Date.now(), { force: true });
+  let journal = await lignes(db, "WHERE agent = 'sites.certificats' AND action IN ('remontee', 'remontee-maj')");
+  assert.deepEqual(journal.map((l) => [l.action, l.org_id]), [['remontee', vermeil.id]], 'chez Vermeil, une ligne pour deux passages');
+
+  await poser(1); // à deux jours ou moins : critique
+  await garde.lancerRonde('sites.certificats', Date.now(), { force: true });
