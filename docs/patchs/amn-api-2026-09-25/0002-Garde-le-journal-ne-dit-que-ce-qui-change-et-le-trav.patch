diff --git a/scripts/rattacher-sites.mjs b/scripts/rattacher-sites.mjs
new file mode 100644
index 0000000..08d5849
--- /dev/null
+++ b/scripts/rattacher-sites.mjs
@@ -0,0 +1,76 @@
+#!/usr/bin/env node
+/**
+ * RATTACHER LES SITES DÉJÀ ENREGISTRÉS À LEUR CLIENTE (chantier « arrivée cliente », partie 4).
+ *
+ * Les sites que surveille AMN DevSec ont été enregistrés avant que
+ * `client_org_id` existe : aucun ne sait de quelle cliente il est le site, et
+ * la Garde range donc encore leur travail sous AMN DevSec. Ce script propose
+ * un rattachement par le NOM : « jardin-elise.fr » ↔ « Le Jardin d’Élise »,
+ * « arnoux-avocats.fr » ↔ « Cabinet Arnoux ».
+ *
+ *   AMN_API_URL=https://… AMN_OPERATEUR=… node scripts/rattacher-sites.mjs            # ne touche à rien : liste les propositions
+ *   AMN_API_URL=https://… AMN_OPERATEUR=… node scripts/rattacher-sites.mjs --appliquer # rattache les propositions SÛRES
+ *
+ * Sûre = une seule cliente correspond. Deux ou plus, ou aucune : le site est
+ * listé « à rattacher à la main » (depuis le Parc) et le script n'y touche pas.
+ * Un site déjà rattaché n'est jamais modifié. Tout passe par l'API
+ * (`PUT /v1/sites/:id`), jamais par la base : les mêmes contrôles qu'à la main.
+ */
+const API = (process.env.AMN_API_URL ?? '').replace(/\/$/, '');
+const JETON = process.env.AMN_OPERATEUR ?? '';
+const APPLIQUER = process.argv.includes('--appliquer');
+if (!API || !JETON) {
+  console.error('AMN_API_URL et AMN_OPERATEUR sont attendus.');
+  process.exit(2);
+}
+
+const appel = async (chemin, init = {}) => {
+  const r = await fetch(`${API}${chemin}`, { ...init, headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${JETON}`, ...(init.headers ?? {}) } });
+  const corps = await r.json().catch(() => null);
+  if (!r.ok) throw new Error(`${chemin} → ${r.status} ${corps?.error ?? ''}`);
+  return corps;
+};
+
+/** Les mots qui ne désignent personne : articles, formes juridiques, métiers trop communs. */
+const VIDES = new Set(['le', 'la', 'les', 'l', 'd', 'de', 'du', 'des', 'et', 'the', 'sarl', 'sas', 'sasu', 'eurl', 'sa', 'sci', 'cabinet', 'atelier', 'maison', 'studio', 'groupe', 'agence', 'societe', 'boutique', 'shop', 'www', 'fr', 'com', 'net', 'org', 'eu', 'io', 'rdv', 'app']);
+const sansAccent = (s) => String(s ?? '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
+const mots = (s) => sansAccent(s).split(/[^a-z0-9]+/).filter((m) => m.length >= 3 && !VIDES.has(m));
+const hote = (site) => { try { return new URL(site.url).hostname; } catch { return site.name; } };
+
+export function proposer(site, clientes) {
+  const cote = new Set(mots(hote(site)));
+  const colle = sansAccent(hote(site)).replace(/[^a-z0-9]/g, '');
+  const candidates = clientes.filter((o) => {
+    const m = mots(o.name);
+    if (m.length === 0) return false;
+    // Tous les mots distinctifs du nom de la cliente se retrouvent dans l'hôte (séparés ou collés : « leshalles »).
+    return m.every((x) => cote.has(x) || colle.includes(x));
+  });
+  return candidates;
+}
+
+async function toutesLesClientes() {
+  const clientes = [];
+  let cursor = null;
+  do {
+    const page = await appel(`/v1/admin/organizations/page?limit=200${cursor ? `&cursor=${encodeURIComponent(cursor)}` : ''}`);
+    clientes.push(...page.organizations.filter((o) => o.plan !== 'internal'));
+    cursor = page.nextCursor ?? null;
+  } while (cursor);
+  return clientes;
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const { sites } = await appel('/v1/sites');
+  const clientes = await toutesLesClientes();
+  const bilan = { rattaches: 0, deja: 0, main: [] };
+  for (const site of sites) {
+    if (site.clientOrgId) { bilan.deja += 1; continue; }
+    const c = proposer(site, clientes);
+    if (c.length !== 1) { bilan.main.push(`${site.name} — ${c.length ? `ambigu : ${c.map((o) => o.name).join(', ')}` : 'aucune cliente ne correspond'}`); continue; }
+    console.log(`${APPLIQUER ? 'rattaché' : 'proposé '}  ${site.name}  →  ${c[0].name}`);
+    if (APPLIQUER) { await appel(`/v1/sites/${site.id}`, { method: 'PUT', body: JSON.stringify({ clientOrgId: c[0].id }) }); bilan.rattaches += 1; }
+  }
+  for (const l of bilan.main) console.log(`à la main  ${l}`);
+  console.log(`\n${sites.length} site(s) : ${bilan.deja} déjà rattaché(s), ${APPLIQUER ? `${bilan.rattaches} rattaché(s) maintenant` : 'rien modifié (relancer avec --appliquer)'}, ${bilan.main.length} à rattacher à la main depuis le Parc.`);
+}
