+import { readFileSync } from 'node:fs';
+
+/*
+  L'E-MAIL D'INVITATION DE MARQUE (cahier 43a, paquet Claude Design) : le
+  gabarit du paquet, tel quel, dans src/lib/modeles/. Tables pour Outlook,
+  variante sombre pour Apple Mail, texte réel partout sauf le logo ; le seul
+  ambre est le talon. On n'y remplace que les variables {{…}}, chacune échappée.
+*/
+const GABARIT_INVITATION = {
+  html: readFileSync(new URL('./modeles/invitation.template.html', import.meta.url), 'utf8'),
+  texte: readFileSync(new URL('./modeles/invitation.template.txt', import.meta.url), 'utf8'),
+};
+const PARIS = 'Europe/Paris';
+const jourDuMois = (d) => Number(d.toLocaleDateString('fr-FR', { day: 'numeric', timeZone: PARIS }));
+const heureParis = (d) => d.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', timeZone: PARIS });
+/** « 25 SEPT. 2026 » */
+export const dateEnvoi = (d) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric', timeZone: PARIS }).toUpperCase();
+/** « VENDREDI 2 OCTOBRE · 16:04 » — l'heure exacte : le lien dure 7 × 24 h depuis l'émission, pas jusqu'à minuit. */
+export const dateTalon = (d) => `${d.toLocaleDateString('fr-FR', { weekday: 'long', timeZone: PARIS })} ${jourDuMois(d) === 1 ? '1er' : jourDuMois(d)} ${d.toLocaleDateString('fr-FR', { month: 'long', timeZone: PARIS })} · ${heureParis(d)}`.toUpperCase();
+/** « 2 octobre » */
+export const dateCourte = (d) => `${jourDuMois(d) === 1 ? '1er' : jourDuMois(d)} ${d.toLocaleDateString('fr-FR', { month: 'long', timeZone: PARIS })}`;
+/** « vendredi 2 octobre à 16:04 » */
+export const dateTexte = (d) => `${d.toLocaleDateString('fr-FR', { weekday: 'long', timeZone: PARIS })} ${dateCourte(d)} à ${heureParis(d)}`;
+
+/**
+ * Les deux cas du cahier : AMN ouvre l'espace d'une cliente (`cas: 'amn'`),
+ * ou une personne de l'équipe invite (`cas: 'equipe'`). Tout vient de
+ * l'invitation réelle ; aucune donnée d'exemple.
+ */
+export function variablesInvitation({ cas = 'amn', org, prenom, libelle, email, role, lien, emisLe, expireLe, logoBase = null, mentionLegale = null }) {
+  const qui = prenom || (cas === 'amn' ? 'AMN' : org);
+  const emis = new Date(emisLe ?? Date.now());
+  const expire = new Date(expireLe);
+  const equipe = cas === 'equipe';
+  return {
+    objet: equipe ? `${qui} vous invite dans l’espace ${org}` : `Votre espace ${org} est prêt`,
+    apercu: 'Un lien pour l’activer, valable sept jours. Aucun mot de passe dans ce message : c’est vous qui le choisirez.',
+    organisation: org,
+    phrase: equipe ? `${qui} vous invite à rejoindre l’espace de votre équipe.` : 'Votre espace de travail est prêt. Il ne reste qu’à l’activer.',
+    invite_par: `${qui}${libelle ? ` · ${libelle}` : ''}`,
+    invite_par_long: equipe ? `${qui}${libelle ? `, ${libelle}` : ''}` : `${qui}, de l’équipe AMN`,
+    email,
+    role,
+    envoye_le: dateEnvoi(emis),
+    expire_le: dateTalon(expire),
+    expire_court: dateCourte(expire),
+    expire_texte: dateTexte(expire),
+    intro: equipe ? `${qui} vous invite à rejoindre l’espace de travail de ${org} sur AMN Desktop.` : `${qui}, de l’équipe AMN, vous invite à activer l’espace de travail de ${org} sur AMN Desktop.`,
+    lien,
+    logo_encre: logoBase ? `${logoBase}/email/logo-amn-encre-2x.png` : '',
+    logo_blanc: logoBase ? `${logoBase}/email/logo-amn-blanc-2x.png` : '',
+    mention_legale: mentionLegale ?? '',
+  };
+}
+
+const remplir = (gabarit, v, echappe) => gabarit.replace(/\{\{(\w+)\}\}/g, (_, k) => (echappe ? echapper(v[k] ?? '') : String(v[k] ?? '')));
+
+export function rendreInvitationDeMarque(params) {
+  const v = variablesInvitation(params);
+  let html = remplir(GABARIT_INVITATION.html, v, true);
+  // Sans adresse d'hébergement, pas d'image : le texte de remplacement « AMN » suffit, jamais une URL relative qui casserait.
+  if (!v.logo_encre) html = html.replace(/<img class="l-light"[^>]*>/, '<span style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;font-weight:bold;letter-spacing:3px;color:#0a0a0a">AMN</span>').replace(/<!--\[if !mso\]><!--><img class="l-dark"[^>]*><!--<!\[endif\]-->/, '');
+  if (!v.mention_legale) html = html.replace('.<br></td>', '.</td>');
+  // La typographie française sur le corps seulement (jamais la feuille de style).
+  const i = html.indexOf('<body');
+  html = html.slice(0, i) + typographieFr(html.slice(i));
+  const texte = typographieFr(remplir(GABARIT_INVITATION.texte, v, false)).replace(/\n+$/, '\n');
+  return { sujet: typographieFr(v.objet), texte, html };
+}
+
 export const NATURES = ['invitation', 'demande_invitation', 'relance_facture', 'bienvenue', 'reinitialisation', 'rapport_mensuel', 'preavis_impaye', 'reactivation', 'notification_critique', 'lettre'];
 /** Ce qui ne part qu'avec l'accord explicite de la personne (préférences `courrier.*`). */
 export const NATURES_OPT_IN = { notification_critique: 'courrier.critique', lettre: 'courrier.lettre' };
