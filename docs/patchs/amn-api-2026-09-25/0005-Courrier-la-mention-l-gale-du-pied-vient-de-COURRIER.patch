+/*
+  LA MENTION LÉGALE du pied de courriel (raison sociale, forme, SIREN, adresse)
+  vient de l'environnement (`COURRIER_MENTION_LEGALE`) et de nulle part
+  ailleurs : aucune n'est inventée. Absente, le pied n'en porte pas.
+*/
+export function configurerCourrier({ apiKey = null, expediteur = null, secret = null, mentionLegale = null, fetchImpl = globalThis.fetch, horloge = () => Date.now() } = {}) {
+  etat = { apiKey: apiKey || null, expediteur: expediteur || null, secret: secret || apiKey || 'sans-secret', mentionLegale: String(mentionLegale ?? '').trim().slice(0, 300) || null, fetchImpl, horloge };
   return courrierActif();
 }
 export const courrierActif = () => Boolean(etat.apiKey && etat.expediteur);
@@ -102,7 +107,11 @@ export async function envoyer(db, { orgId = null, a, nature, langue = 'fr', para
