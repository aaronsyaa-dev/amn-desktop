+const { config } = await import('../src/config.js');
+const { dateDInvitation } = await import('../src/lib/invitations.js');
+
+/**
+ * LE COURRIER QUI PART SEUL (chantier « arrivée cliente », partie 2) :
+ * l'invitation d'une nouvelle cliente, et la relance d'une facture échue.
+ * Resend est simulé ; tout le reste — routes, garde-fous, journal — est réel.
+ */
+const OPERATOR = 'test-operator-token';
+const MDP = 'motdepasse-solide';
+
+function fauxResend() {
+  const envois = [];
+  const fetchImpl = async (url, init) => {
+    envois.push(JSON.parse(init.body));
+    return new Response(JSON.stringify({ id: `re_${envois.length}` }), { status: 200 });
+  };
+  return { envois, fetchImpl };
+}
+
+async function decor(t, { courrier = true, adresseApp = 'https://app.exemple.test' } = {}) {
+  const resend = fauxResend();
+  const db = createSqliteDb(':memory:');
+  await db.init();
+  const app = await createApp({ db });
+  configurerCourrier(courrier ? { apiKey: 're_test', expediteur: 'AMN <bonjour@amn.test>', fetchImpl: resend.fetchImpl } : {});
+  const avant = config.businessPublicUrl;
+  config.businessPublicUrl = adresseApp;
+  const server = http.createServer(app);
+  await new Promise((r) => server.listen(0, r));
+  const base = `http://127.0.0.1:${server.address().port}`;
+  t.after(async () => { config.businessPublicUrl = avant; configurerCourrier({}); server.closeAllConnections?.(); await new Promise((r) => server.close(r)); await db.close(); });
+  const api = async (path, { token, method = 'GET', body } = {}) => {
+    const r = await fetch(`${base}${path}`, { method, headers: { 'Content-Type': 'application/json', ...(token ? { Authorization: `Bearer ${token}` } : {}) }, body: body === undefined ? undefined : JSON.stringify(body) });
+    return { status: r.status, body: await r.json().catch(() => null) };
+  };
+  const login = async (email) => (await api('/v1/auth/login', { method: 'POST', body: { email, password: MDP } })).body.token;
+  return { db, api, login, resend };
+}
+
+test('créer une cliente envoie son invitation : son lien, la date en toutes lettres, qui invite — et jamais de mot de passe', async (t) => {
+  const { db, api, resend } = await decor(t);
+  const r = await api('/v1/admin/organizations', { token: OPERATOR, method: 'POST', body: { name: 'Fleurs de Lune', plan: 'business_standard', ownerEmail: 'medina@exemple.test', invitePar: 'Harun' } });
+  assert.equal(r.status, 201);
+  assert.deepEqual(r.body.invitation.courrier, { envoye: true });
+  assert.equal(resend.envois.length, 1);
+  const m = resend.envois[0];
+  assert.deepEqual(m.to, ['medina@exemple.test']);
+  assert.equal(m.subject, 'Votre espace Fleurs de Lune est prêt');
+  assert.ok(m.text.includes(r.body.invitation.url), 'le lien d’activation');
+  assert.ok(m.text.includes(`jusqu’au ${dateDInvitation(r.body.invitation.expiresAt)}`));
+  assert.ok(m.text.includes('Harun vous a ouvert'));
+  assert.ok(!/mot de passe\s*[:=]/i.test(m.text) && !m.html.includes('password'), 'aucun mot de passe');
+  assert.equal(m.reply_to, undefined);
+  const journal = await db.all("SELECT nature, etat, destinataire FROM courriers WHERE nature = 'invitation'");
+  assert.deepEqual(journal, [{ nature: 'invitation', etat: 'envoye', destinataire: 'medina@exemple.test' }]);
