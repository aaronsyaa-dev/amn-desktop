+/* ─────────────────────────── La relance d'une facture ─────────────────────────── */
+
+async function decorFactures(t, opts) {
+  const d = await decor(t, opts);
+  const hash = await hashPassword(MDP);
+  const org = await d.db.createOrganization({ name: 'Fleurs de Lune', plan: 'business_standard' });
+  const voisine = await d.db.createOrganization({ name: 'Voisine', plan: 'business_standard' });
+  await d.db.createUser({ orgId: org.id, email: 'medina@fleurs.test', passwordHash: hash, role: 'owner', status: 'active' });
+  await d.db.createUser({ orgId: org.id, email: 'invite@fleurs.test', passwordHash: hash, role: 'guest', status: 'active' });
+  await d.db.createUser({ orgId: voisine.id, email: 'v@voisine.test', passwordHash: hash, role: 'owner', status: 'active' });
+  const facture = (id, extra = {}) => d.db.upsertRecord(org.id, 'invoices', id, { number: `F-${id}`, status: 'issued', kind: 'invoice', dueAt: '2026-09-01', billTo: { name: 'Mme Roux', company: '', email: 'roux@client.test', address: '', vatNumber: '' }, ...extra });
+  await facture('014');
+  await facture('015', { dueAt: '2099-01-01' });
+  await facture('016', { billTo: { name: 'Sans adresse', company: '', email: '', address: '', vatNumber: '' } });
+  await d.db.upsertRecord(voisine.id, 'invoices', '900', { number: 'V-900', status: 'issued', kind: 'invoice', dueAt: '2026-09-01', billTo: { name: 'X', company: '', email: 'x@client.test', address: '', vatNumber: '' } });
+  return { ...d, org };
+}
+const TEXTE = 'Bonjour Madame Roux,\n\nLa facture F-014 de 480,00 € était due le 1er septembre. Pouvez-vous me dire où en est son règlement ?\n\nMedina';
