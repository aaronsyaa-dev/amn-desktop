diff --git a/src/lib/invitations.js b/src/lib/invitations.js
index 3a8959c..0231e17 100644
--- a/src/lib/invitations.js
+++ b/src/lib/invitations.js
@@ -21,3 +21,32 @@ export function nomInvitant(brut, repli = null) {
   if (nom && !nom.includes('@')) return nom;
   return repli ? String(repli).slice(0, 60) : null;
 }
+
+/** « 2026-10-01T… » → « 1er octobre » (heure de Paris), comme l'écrit une personne. */
+export function dateDInvitation(iso, langue = 'fr') {
+  const d = new Date(iso);
+  if (Number.isNaN(d.getTime())) return '';
+  if (langue === 'en') return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', timeZone: 'Europe/Paris' });
+  const jour = Number(d.toLocaleDateString('fr-FR', { day: 'numeric', timeZone: 'Europe/Paris' }));
+  const mois = d.toLocaleDateString('fr-FR', { month: 'long', timeZone: 'Europe/Paris' });
+  return `${jour === 1 ? '1er' : jour} ${mois}`;
+}
+
+/**
+ * ENVOIE L'INVITATION PAR COURRIEL, si le courrier est en ligne et que le lien
+ * existe (il faut `APP_PUBLIC_URL`). Rend ce que l'Atelier doit savoir :
+ * `{ envoye: true }`, ou `{ envoye: false, raison }` — et alors le message à
+ * copier reste le chemin. Jamais d'exception : une invitation créée ne doit
+ * pas échouer parce qu'un courriel n'est pas parti.
+ */
+export async function envoyerInvitation(db, { org, email, url, expiresAt, invitePar = null, par = null }) {
+  if (!url) return { envoye: false, raison: 'sans_adresse_app' };
+  try {
+    const { envoyer } = await import('./courrier.js');
+    const langue = org?.language === 'en' ? 'en' : 'fr';
+    const r = await envoyer(db, { orgId: org?.id ?? null, a: email, nature: 'invitation', langue, params: { org: org?.name ?? '', lien: url, invitePar, jusquau: dateDInvitation(expiresAt, langue) }, par });
+    return r.envoye ? { envoye: true } : { envoye: false, raison: r.raison ?? 'echec' };
+  } catch (err) {
+    return { envoye: false, raison: 'echec', erreur: String(err?.message ?? err).slice(0, 120) };
+  }
+}
