+import { Router } from 'express';
+import { tenantAuth } from '../middleware/tenantAuth.js';
+import { rateLimit } from '../middleware/rateLimit.js';
+
+/**
+ * LE HALL — l'espace commun entre organisations VOLONTAIRES (vision cliente,
+ * chantier 4 : « on s'y sent seul, coupé des autres »).
+ *
+ * La règle qui commande tout ce fichier : aucune donnée d'une organisation
+ * n'est visible par une autre sans consentement explicite. Ici le consentement
+ * est un GESTE de propriétaire ou d'admin (`PUT /participation`), révocable
+ * d'un geste, et ce qu'il ouvre est borné et nommé :
+ *
+ *   · ce qui sort vers les autres organisations : le nom d'affichage choisi,
+ *     la signature choisie pour chaque message, le texte du message, l'heure ;
+ *   · ce qui ne sort JAMAIS : les adresses, les identifiants d'organisation ou
+ *     de compte, le nom légal si le nom d'affichage en diffère, et rien des
+ *     collections (tâches, clients, factures…) — le Hall n'a pas de porte
+ *     vers elles.
+ *
+ * Trois verrous, dans l'ordre :
+ *   1. `tenantAuth({ allowSupport: false })` — une session de support (un
+ *      opérateur d'AMN posé sur une cliente) ne parle pas au nom de la cliente
+ *      et ne consent pas à sa place ;
+ *   2. le consentement — sans participation active, ni lecture ni écriture
+ *      (403 `hall_non_rejoint`), et les messages d'une organisation partie
+ *      cessent d'exister pour les autres à l'instant (la requête de lecture
+ *      joint sur `left_at IS NULL`, il n'y a pas d'état à nettoyer) ;
+ *   3. les rôles — consentir : owner/admin ; écrire : owner/admin/member,
+ *      jamais guest ; lire : tout membre d'une organisation qui participe.
+ *
+ * Le texte est stocké tel quel et rendu comme TEXTE côté poste (React
+ * échappe ; aucun HTML n'est interprété). Bornes : 600 caractères, dix
+ * messages par personne par dix minutes, 30 caractères de signature.
+ */
+const BODY_MAX = 600;
+const SIGNATURE_MAX = 30;
+const DISPLAY_NAME_MAX = 60;
+
+/** Ce qu'une autre organisation a le droit de voir d'un message — et rien d'autre. */
+function vue(m, orgId) {
+  return {
+    id: m.id,
+    org: m.orgDisplayName,
+    signature: m.signature,
+    body: m.body,
+    createdAt: m.createdAt,
+    mienne: m.orgId === orgId,
+  };
+}
+
+function nettoyerLigne(v, max) {
+  return String(v ?? '')
+    .replace(/[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]/g, '')
+    .trim()
+    .slice(0, max);
+}
+
+export function hallRouter() {
+  const router = Router();
+  const auth = tenantAuth({ allowSupport: false });
+  const consentir = tenantAuth({ allowSupport: false, allowWeb: false, roles: ['owner', 'admin'] });
+  const ecrire = tenantAuth({ allowSupport: false, allowWeb: false, roles: ['owner', 'admin', 'member'] });
+
+  const participationActive = async (req, res) => {
+    const p = await req.app.locals.db.getHallParticipation(req.auth.orgId);
+    if (!p?.participe) {
+      res.status(403).json({ error: 'Votre organisation n’a pas rejoint le Hall.', code: 'hall_non_rejoint' });
+      return null;
+    }
+    return p;
+  };
+
+  /* Où en est MON organisation, et combien d'organisations y parlent (un nombre, pas des noms). */
+  router.get('/participation', auth, async (req, res) => {
+    const db = req.app.locals.db;
+    const p = await db.getHallParticipation(req.auth.orgId);
+    res.json({
+      participation: p ? { participe: p.participe, displayName: p.displayName, joinedAt: p.joinedAt, leftAt: p.leftAt } : null,
+      participants: await db.countHallParticipants(),
+    });
+  });
+
+  /* Le consentement — et son retrait. Un geste de propriétaire ou d'admin, journalisé par l'adresse qui l'a fait. */
+  router.put('/participation', consentir, async (req, res) => {
+    const db = req.app.locals.db;
+    const participe = req.body?.participe === true;
+    const org = await db.getOrganization(req.auth.orgId);
+    const displayName = nettoyerLigne(req.body?.displayName, DISPLAY_NAME_MAX) || org?.name || 'Une organisation';
+    const p = await db.setHallParticipation(req.auth.orgId, { participe, displayName, byEmail: req.user?.email ?? 'inconnue' });
+    const hub = req.app.locals.hub;
+    if (hub) {
+      hub.tower({ type: 'hall:participation', orgName: org?.name ?? null, displayName, participe });
+      /* Les écrans ouverts chez les participantes relisent : une organisation partie disparaît à l'instant, une arrivée compte. */
+      for (const autre of await db.listHallParticipants()) hub.broadcast({ type: 'hall:rafraichir' }, autre.orgId);
+    }
+    res.json({
+      participation: p ? { participe: p.participe, displayName: p.displayName, joinedAt: p.joinedAt, leftAt: p.leftAt } : null,
+      participants: await db.countHallParticipants(),
+    });
+  });
+
+  router.get('/messages', auth, async (req, res) => {
+    if (!(await participationActive(req, res))) return;
+    const messages = await req.app.locals.db.listHallMessages({ limit: 100 });
+    res.json({ messages: messages.map((m) => vue(m, req.auth.orgId)).reverse() });
+  });
+
+  router.post(
+    '/messages',
+    ecrire,
+    rateLimit({ name: 'hall-write', max: 10, windowMs: 10 * 60_000, key: (req) => req.auth?.userId ?? req.auth?.orgId ?? 'anonyme' }),
+    async (req, res) => {
+      const p = await participationActive(req, res);
+      if (!p) return;
+      const db = req.app.locals.db;
+      const brut = String(req.body?.body ?? '');
+      if (brut.length > BODY_MAX) {
+        return res.status(400).json({ error: `Un message tient en ${BODY_MAX} caractères.`, code: 'hall_trop_long' });
+      }
+      const body = brut.replace(/[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]/g, '').trim();
+      if (!body) return res.status(400).json({ error: 'Un message vide ne se poste pas.', code: 'hall_vide' });
+      const signature = nettoyerLigne(req.body?.signature, SIGNATURE_MAX);
+      const m = await db.createHallMessage({ orgId: req.auth.orgId, authorUserId: req.auth.userId ?? null, signature, body });
+      /* Chaque organisation qui participe reçoit la trame — chacune sur SA socket, jamais un envoi à tout le monde. */
+      const hub = req.app.locals.hub;
+      if (hub) {
+        for (const autre of await db.listHallParticipants()) {
+          hub.broadcast({ type: 'hall:message', message: vue(m, autre.orgId) }, autre.orgId);
+        }
+      }
+      res.status(201).json({ message: vue(m, req.auth.orgId) });
+    },
+  );
+
+  /* Signaler : le message reste, AMN DevSec est prévenue par la file d'assistance — un humain tranche. */
+  router.post(
+    '/messages/:id/signaler',
+    ecrire,
+    rateLimit({ name: 'hall-signal', max: 20, windowMs: 60 * 60_000, key: (req) => req.auth?.userId ?? req.auth?.orgId ?? 'anonyme' }),
+    async (req, res) => {
+      if (!(await participationActive(req, res))) return;
+      const db = req.app.locals.db;
+      const m = await db.getHallMessage(String(req.params.id));
+      if (!m || m.hiddenAt) return res.status(404).json({ error: 'Message introuvable.' });
+      await db.flagHallMessage(m.id);
+      const org = await db.getOrganization(req.auth.orgId);
+      const request = await db.createSupportRequest({
+        orgId: req.auth.orgId,
+        kind: 'message',
+        subject: 'Signalement dans le Hall',
+        body: `Message ${m.id} de « ${m.orgDisplayName} » signalé.\n\n« ${m.body.slice(0, 300)} »`,
+        requestedBy: req.auth.userId ?? null,
+        requestedByEmail: req.user?.email ?? `jeton partagé (${req.auth.scope})`,
+      });
+      req.app.locals.hub?.tower({ type: 'support:request', request: { ...request, orgName: org?.name ?? null } });
+      res.json({ ok: true });
+    },
+  );
+
+  return router;
+}
