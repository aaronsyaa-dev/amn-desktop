diff --git a/test/hall.test.js b/test/hall.test.js
new file mode 100644
index 0000000..1081dd5
--- /dev/null
+++ b/test/hall.test.js
@@ -0,0 +1,228 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import http from 'node:http';
+
+process.env.NODE_ENV = 'test';
+process.env.OPERATOR_TOKEN = 'test-operator-token';
+
+const { createApp } = await import('../src/server.js');
+const { createSqliteDb } = await import('../src/db/sqlite.js');
+const { AMN_ORG_ID } = await import('../src/db/tenancy.js');
+const { hashPassword } = await import('../src/lib/password.js');
+const { _resetRateLimits } = await import('../src/middleware/rateLimit.js');
+
+/**
+ * LE HALL — les verrous de consentement et d'isolation, cassés un par un.
+ *
+ * Ce que ces tests prouvent : sans consentement, rien ne se lit ni ne s'écrit ;
+ * un membre ne consent pas pour son organisation ; une session de support ne
+ * consent pas ni ne parle au nom d'une cliente ; ce qui sort vers les autres
+ * ne porte ni adresse ni identifiant ; quitter efface aux yeux des autres ;
+ * masquer (AMN) efface aussi ; le texte est stocké tel quel, borné ; le
+ * frein par personne tient.
+ */
+const MDP = 'motdepasse-solide';
+
+async function decor(t) {
+  _resetRateLimits();
+  const db = createSqliteDb(':memory:');
+  await db.init();
+  const app = await createApp({ db });
+  const server = http.createServer(app);
+  await new Promise((resolve) => server.listen(0, resolve));
+  const { port } = server.address();
+  t.after(async () => {
+    server.closeAllConnections?.();
+    await new Promise((resolve) => server.close(resolve));
+    await db.close();
+  });
+  const base = `http://127.0.0.1:${port}`;
+  const login = async (email) => {
+    const r = await fetch(`${base}/v1/auth/login`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email, password: MDP }) });
+    assert.equal(r.status, 200, `connexion ${email}`);
+    return (await r.json()).token;
+  };
+  const api = (token) => async (path, init = {}) => {
+    const r = await fetch(`${base}${path}`, { ...init, headers: { 'Content-Type': 'application/json', ...(token ? { Authorization: `Bearer ${token}` } : {}), ...(init.headers ?? {}) } });
+    let body = null;
+    try { body = await r.json(); } catch { body = null; }
+    return { status: r.status, body };
+  };
+  const compte = async (orgId, email, role) => db.createUser({ orgId, email, passwordHash: await hashPassword(MDP), role, status: 'active' });
+  await compte(AMN_ORG_ID, 'aaron@amn-test.local', 'owner');
+  const a = await db.createOrganization({ name: 'Cliente A', plan: 'business_standard' });
+  const b = await db.createOrganization({ name: 'Cliente B', plan: 'business_standard' });
+  const c = await db.createOrganization({ name: 'Cliente C', plan: 'business_standard' });
+  await compte(a.id, 'nadia@a.test', 'owner');
+  await compte(a.id, 'sofia@a.test', 'member');
+  await compte(a.id, 'invite@a.test', 'guest');
+  await compte(b.id, 'lea@b.test', 'owner');
+  await compte(c.id, 'marc@c.test', 'owner');
+  const operateur = api('test-operator-token');
+  return { db, api, login, a, b, c, base, operateur };
+}
+
+const json = (o) => ({ method: 'PUT', body: JSON.stringify(o) });
+const post = (o) => ({ method: 'POST', body: JSON.stringify(o) });
+
+test('sans consentement, ni lecture ni écriture ; un membre ne consent pas ; le propriétaire consent et le retire', async (t) => {
+  const { api, login } = await decor(t);
+  const nadia = api(await login('nadia@a.test'));
+  const sofia = api(await login('sofia@a.test'));
+
+  const etat = await nadia('/v1/hall/participation');
+  assert.equal(etat.status, 200);
+  assert.equal(etat.body.participation, null);
+  assert.equal(etat.body.participants, 0);
+
+  assert.equal((await nadia('/v1/hall/messages')).status, 403);
+  assert.equal((await nadia('/v1/hall/messages')).body.code, 'hall_non_rejoint');
+  assert.equal((await nadia('/v1/hall/messages', post({ body: 'Bonjour' }))).status, 403);
+
+  const refus = await sofia('/v1/hall/participation', json({ participe: true }));
+  assert.equal(refus.status, 403, 'une membre ne consent pas pour son organisation');
+
+  const oui = await nadia('/v1/hall/participation', json({ participe: true, displayName: '  Syraagensy  ' }));
+  assert.equal(oui.status, 200);
+  assert.equal(oui.body.participation.participe, true);
+  assert.equal(oui.body.participation.displayName, 'Syraagensy');
+  assert.equal(oui.body.participants, 1);
+
+  assert.equal((await sofia('/v1/hall/messages')).status, 200, 'une membre lit dès que son organisation participe');
+
+  const non = await nadia('/v1/hall/participation', json({ participe: false }));
+  assert.equal(non.body.participation.participe, false);
+  assert.equal(non.body.participants, 0);
+  assert.equal((await sofia('/v1/hall/messages')).status, 403, 'le retrait ferme la porte à l’instant');
+});
+
+test('ce qui sort vers une autre organisation : le nom choisi, la signature, le texte — jamais une adresse ni un identifiant', async (t) => {
+  const { api, login, a } = await decor(t);
+  const nadia = api(await login('nadia@a.test'));
+  const lea = api(await login('lea@b.test'));
+  await nadia('/v1/hall/participation', json({ participe: true, displayName: 'Syraagensy' }));
+  await lea('/v1/hall/participation', json({ participe: true }));
+
+  const envoye = await nadia('/v1/hall/messages', post({ body: 'Quelqu’un a un modèle de devis pour une agence ?', signature: 'Nadia' }));
+  assert.equal(envoye.status, 201);
+  const m = envoye.body.message;
+  assert.deepEqual(Object.keys(m).sort(), ['body', 'createdAt', 'id', 'mienne', 'org', 'signature'].sort());
+  assert.equal(m.org, 'Syraagensy');
+  assert.equal(m.mienne, true);
+
+  const vuParLea = await lea('/v1/hall/messages');
+  assert.equal(vuParLea.status, 200);
+  assert.equal(vuParLea.body.messages.length, 1);
+  const chezLea = vuParLea.body.messages[0];
+  assert.equal(chezLea.mienne, false);
+  assert.equal(chezLea.org, 'Syraagensy');
+  const texte = JSON.stringify(vuParLea.body);
+  assert.ok(!texte.includes('nadia@a.test'), 'aucune adresse');
+  assert.ok(!texte.includes(a.id), 'aucun identifiant d’organisation');
+  assert.ok(!texte.includes('Cliente A'), 'pas le nom légal quand le nom d’affichage en diffère');
+
+  /* Léa n'a pas choisi de nom : c'est le nom de son organisation, tel quel — son choix par défaut, pas une fuite. */
+  const deLea = await lea('/v1/hall/messages', post({ body: 'Oui, je vous envoie ça.' }));
+  assert.equal(deLea.body.message.org, 'Cliente B');
+});
+
+test('quitter le Hall efface ses messages aux yeux des autres ; y revenir les rend', async (t) => {
+  const { api, login } = await decor(t);
+  const nadia = api(await login('nadia@a.test'));
+  const lea = api(await login('lea@b.test'));
+  await nadia('/v1/hall/participation', json({ participe: true, displayName: 'Syraagensy' }));
+  await lea('/v1/hall/participation', json({ participe: true }));
+  await nadia('/v1/hall/messages', post({ body: 'Premier message.' }));
