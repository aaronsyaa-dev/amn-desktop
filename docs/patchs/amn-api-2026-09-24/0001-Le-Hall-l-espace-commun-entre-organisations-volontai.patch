+
+  await nadia('/v1/hall/participation', json({ participe: false }));
+  assert.equal((await lea('/v1/hall/messages')).body.messages.length, 0, 'partie : plus rien d’elle');
+
+  await nadia('/v1/hall/participation', json({ participe: true, displayName: 'Syraagensy' }));
+  assert.equal((await lea('/v1/hall/messages')).body.messages.length, 1, 'revenue : ses messages reviennent');
