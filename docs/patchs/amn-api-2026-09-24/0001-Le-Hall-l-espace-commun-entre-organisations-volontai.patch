+test('le texte est stocké tel quel (l’échappement est l’affaire de l’écran) et borné ; le vide est refusé ; le frein tient', async (t) => {
+  const { api, login } = await decor(t);
+  const nadia = api(await login('nadia@a.test'));
+  await nadia('/v1/hall/participation', json({ participe: true }));
+
+  const xss = '<img src=x onerror="alert(1)"><script>alert(2)</script> & "guillemets"';
+  const m = await nadia('/v1/hall/messages', post({ body: xss, signature: '<b>Nadia</b>' }));
+  assert.equal(m.status, 201);
+  assert.equal(m.body.message.body, xss);
+  assert.equal(m.body.message.signature, '<b>Nadia</b>');
+  const relu = await nadia('/v1/hall/messages');
+  assert.equal(relu.body.messages.at(-1).body, xss);
+
+  assert.equal((await nadia('/v1/hall/messages', post({ body: 'x'.repeat(601) }))).status, 400);
+  assert.equal((await nadia('/v1/hall/messages', post({ body: '   \n\t ' }))).status, 400);
+  assert.equal((await nadia('/v1/hall/messages', post({ body: 'ok\u0000\u0007' }))).body.message.body, 'ok');
+  const longueSignature = await nadia('/v1/hall/messages', post({ body: 'ok', signature: 's'.repeat(80) }));
+  assert.equal(longueSignature.body.message.signature.length, 30);
+
+  /* 10 passages par personne par dix minutes — les refus (trop long, vide) comptent aussi, c'est un frein
