diff --git a/test/casser-vision.test.js b/test/casser-vision.test.js
new file mode 100644
index 0000000..b1cc33b
--- /dev/null
+++ b/test/casser-vision.test.js
@@ -0,0 +1,181 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import http from 'node:http';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+
+process.env.NODE_ENV = 'test';
+process.env.OPERATOR_TOKEN = 'test-operator-token';
+
+const { createApp } = await import('../src/server.js');
+const { createSqliteDb } = await import('../src/db/sqlite.js');
+const { AMN_ORG_ID } = await import('../src/db/tenancy.js');
+const { hashPassword } = await import('../src/lib/password.js');
+const { _resetRateLimits } = await import('../src/middleware/rateLimit.js');
+
+/**
+ * CASSER POUR CORRIGER — ce que la vision cliente a ajouté, sous les coups
+ * que la mandat nomme : suspension et suppression d'une organisation,
+ * redémarrage du serveur, écritures simultanées, volumes, cas limites.
+ */
+const MDP = 'motdepasse-solide';
+async function decor(t, { fichier = null } = {}) {
+  _resetRateLimits();
+  const db = createSqliteDb(fichier ?? ':memory:');
+  await db.init();
+  const app = await createApp({ db });
+  const server = http.createServer(app);
+  await new Promise((resolve) => server.listen(0, resolve));
+  const { port } = server.address();
+  const fermer = async () => {
+    server.closeAllConnections?.();
+    await new Promise((resolve) => server.close(resolve));
+    await db.close();
+  };
+  t.after(async () => { try { await fermer(); } catch { /* déjà fermé */ } });
+  const base = `http://127.0.0.1:${port}`;
+  const hash = await hashPassword(MDP);
+  const compte = (orgId, email, role) => db.createUser({ orgId, email, passwordHash: hash, role, status: 'active' });
+  await compte(AMN_ORG_ID, 'aaron@amn-test.local', 'owner');
+  const a = await db.createOrganization({ name: 'Cliente A', plan: 'business_standard' });
+  const b = await db.createOrganization({ name: 'Cliente B', plan: 'business_standard' });
+  await compte(a.id, 'nadia@a.test', 'owner');
+  await compte(b.id, 'lea@b.test', 'owner');
+  const login = async (email) => {
+    const r = await fetch(`${base}/v1/auth/login`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email, password: MDP }) });
+    assert.equal(r.status, 200, `connexion ${email}`);
+    return (await r.json()).token;
+  };
+  const api = (token) => async (p, init = {}) => {
+    const r = await fetch(`${base}${p}`, { ...init, headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}`, ...(init.headers ?? {}) } });
+    let body = null;
+    try { body = await r.json(); } catch { body = null; }
+    return { status: r.status, body };
+  };
+  return { db, api, login, a, b, base, fermer };
+}
+const json = (o) => ({ method: 'PUT', body: JSON.stringify(o) });
+const post = (o) => ({ method: 'POST', body: JSON.stringify(o) });
+
+test('une organisation suspendue disparaît du Hall pour les autres ; réactivée, elle revient', async (t) => {
+  const { api, login, a } = await decor(t);
+  const nadia = api(await login('nadia@a.test'));
+  const lea = api(await login('lea@b.test'));
+  const aaron = api(await login('aaron@amn-test.local'));
+  await nadia('/v1/hall/participation', json({ participe: true, displayName: 'Syraagensy' }));
+  await lea('/v1/hall/participation', json({ participe: true }));
+  await nadia('/v1/hall/messages', post({ body: 'Avant la suspension.' }));
+  assert.equal((await lea('/v1/hall/messages')).body.messages.length, 1);
+  assert.equal((await lea('/v1/hall/participation')).body.participants, 2);
+
+  assert.equal((await aaron(`/v1/admin/organizations/${a.id}/status`, json({ status: 'suspended' }))).status, 200);
+  assert.equal((await lea('/v1/hall/messages')).body.messages.length, 0, 'suspendue : plus rien d’elle');
+  assert.equal((await lea('/v1/hall/participation')).body.participants, 1);
+  const suspendue = await nadia('/v1/hall/messages');
+  assert.ok(suspendue.status === 401 || suspendue.status === 403, `sa session ne parle plus : ${suspendue.status}`);
+
+  assert.equal((await aaron(`/v1/admin/organizations/${a.id}/status`, json({ status: 'active' }))).status, 200);
+  assert.equal((await lea('/v1/hall/messages')).body.messages.length, 1, 'réactivée : ses messages reviennent');
+});
+
+test('une organisation supprimée ne laisse rien dans le Hall', async (t) => {
+  const { api, login, a } = await decor(t);
+  const nadia = api(await login('nadia@a.test'));
+  const lea = api(await login('lea@b.test'));
+  const aaron = api(await login('aaron@amn-test.local'));
+  await nadia('/v1/hall/participation', json({ participe: true, displayName: 'Syraagensy' }));
+  await lea('/v1/hall/participation', json({ participe: true }));
+  await nadia('/v1/hall/messages', post({ body: 'Je vais disparaître.' }));
+  const suppression = await aaron(`/v1/admin/organizations/${a.id}`, { method: 'DELETE', body: JSON.stringify({ confirm: 'Cliente A', confirmName: 'Cliente A', name: 'Cliente A' }) });
+  assert.ok([200, 204].includes(suppression.status), `suppression : ${suppression.status} ${JSON.stringify(suppression.body)}`);
+  assert.equal((await lea('/v1/hall/messages')).body.messages.length, 0);
+  assert.equal((await lea('/v1/hall/participation')).body.participants, 1);
+  const tout = await aaron('/v1/admin/hall/messages');
+  assert.equal(tout.body.messages.length, 0, 'même pour la modération : la ligne est partie avec l’organisation');
+});
+
+test('le Hall survit à un redémarrage du serveur : ce qui a été dit reste dit', async (t) => {
+  const dossier = fs.mkdtempSync(path.join(os.tmpdir(), 'amn-hall-'));
+  const fichier = path.join(dossier, 'hall.db');
+  const premier = await decor(t, { fichier });
+  const nadia = premier.api(await premier.login('nadia@a.test'));
+  await nadia('/v1/hall/participation', json({ participe: true, displayName: 'Syraagensy' }));
+  await nadia('/v1/hall/messages', post({ body: 'Écrit avant la coupure.' }));
+  await premier.fermer();
+
+  /* Le serveur repart sur le même fichier : mêmes comptes, même Hall. */
+  const db = createSqliteDb(fichier);
+  await db.init();
+  const app = await createApp({ db });
+  const server = http.createServer(app);
+  await new Promise((resolve) => server.listen(0, resolve));
+  t.after(async () => { server.closeAllConnections?.(); await new Promise((r) => server.close(r)); await db.close(); fs.rmSync(dossier, { recursive: true, force: true }); });
+  const base = `http://127.0.0.1:${server.address().port}`;
+  const r = await fetch(`${base}/v1/auth/login`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: 'nadia@a.test', password: MDP }) });
+  assert.equal(r.status, 200);
+  const { token } = await r.json();
+  const relu = await fetch(`${base}/v1/hall/messages`, { headers: { Authorization: `Bearer ${token}` } });
+  assert.equal(relu.status, 200);
+  const corps = await relu.json();
+  assert.equal(corps.messages.length, 1);
+  assert.equal(corps.messages[0].body, 'Écrit avant la coupure.');
+});
+
+test('écritures simultanées : vingt messages d’un coup, deux consentements croisés — jamais un 500, jamais un doublon', async (t) => {
+  const { api, login } = await decor(t);
+  const nadia = api(await login('nadia@a.test'));
+  const lea = api(await login('lea@b.test'));
+  const croises = await Promise.all([
+    nadia('/v1/hall/participation', json({ participe: true, displayName: 'Syraagensy' })),
+    lea('/v1/hall/participation', json({ participe: true })),
+    nadia('/v1/hall/participation', json({ participe: true, displayName: 'Syraagensy' })),
+    lea('/v1/hall/participation', json({ participe: false })),
+    lea('/v1/hall/participation', json({ participe: true })),
+  ]);
+  for (const r of croises) assert.ok(r.status < 500, `consentement : ${r.status}`);
+  /* Dix par personne par dix minutes : on envoie dix de chaque côté, en même temps. */
+  const salve = await Promise.all([
+    ...Array.from({ length: 10 }, (_, i) => nadia('/v1/hall/messages', post({ body: `Nadia ${i}` }))),
+    ...Array.from({ length: 10 }, (_, i) => lea('/v1/hall/messages', post({ body: `Léa ${i}` }))),
+  ]);
+  for (const r of salve) assert.ok(r.status < 500, `message : ${r.status}`);
+  const acceptes = salve.filter((r) => r.status === 201).length;
+  assert.equal(acceptes, 20);
+  const lus = (await nadia('/v1/hall/messages')).body.messages;
+  assert.equal(lus.length, 20);
+  assert.equal(new Set(lus.map((m) => m.id)).size, 20, 'aucun doublon');
+});
+
+test('volume : au-delà de cent messages, on lit les cent derniers, dans l’ordre, en moins d’une seconde', async (t) => {
+  const { db, api, login, a, b } = await decor(t);
+  const nadia = api(await login('nadia@a.test'));
+  await nadia('/v1/hall/participation', json({ participe: true, displayName: 'Syraagensy' }));
+  await db.setHallParticipation(b.id, { participe: true, displayName: 'Cabinet B', byEmail: 'lea@b.test' });
+  /* Par la base, pour passer sous le frein : le frein protège le serveur, pas le test. */
+  for (let i = 0; i < 260; i++) await db.createHallMessage({ orgId: i % 2 ? a.id : b.id, authorUserId: null, signature: '', body: `n° ${i}` });
+  const debut = Date.now();
+  const lus = await nadia('/v1/hall/messages');
+  const duree = Date.now() - debut;
+  assert.equal(lus.status, 200);
+  assert.equal(lus.body.messages.length, 100);
+  assert.ok(duree < 1000, `lecture en ${duree} ms`);
+  const numeros = lus.body.messages.map((m) => Number(m.body.replace('n° ', '')));
+  assert.deepEqual(numeros, Array.from({ length: 100 }, (_, i) => 160 + i), 'les cent derniers, du plus ancien au plus récent');
+});
+
+test('cas limites : emoji, arabe, sauts de ligne, six cents caractères exacts, signature vide, nom d’affichage de soixante caractères', async (t) => {
+  const { api, login } = await decor(t);
+  const nadia = api(await login('nadia@a.test'));
+  const nom = 'A'.repeat(60);
+  const p = await nadia('/v1/hall/participation', json({ participe: true, displayName: nom + 'BBB' }));
+  assert.equal(p.body.participation.displayName, nom, 'coupé à soixante');
+  for (const body of ['🌸🌷 Bouquet 🍾', 'مرحبا بالجميع', 'ligne 1\nligne 2\n\nligne 4', 'x'.repeat(600)]) {
+    const m = await nadia('/v1/hall/messages', post({ body, signature: '' }));
+    assert.equal(m.status, 201, body.slice(0, 20));
+    assert.equal(m.body.message.body, body);
+    assert.equal(m.body.message.signature, '');
+  }
+  const lus = await nadia('/v1/hall/messages');
+  assert.equal(lus.body.messages.length, 4);
+});
