Chaque garde tient son registre par fermeture ; vider la carte extérieure
ne vidait rien de ce que les gardes lisent. Les tests qui font plus de
gestes que le frein n'en permet peuvent maintenant vraiment repartir de
zéro.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01BEf9qY21FAUuZ4ogxRY3s2
---
 src/middleware/rateLimit.js | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/middleware/rateLimit.js b/src/middleware/rateLimit.js
index 5859896..a56ac9b 100644
--- a/src/middleware/rateLimit.js
+++ b/src/middleware/rateLimit.js
@@ -64,5 +64,7 @@ export function rateLimit({ name, max, windowMs, key = callerIp }) {
 
 /** Pour les tests : oublier tous les compteurs. */
 export function _resetRateLimits() {
-  registres.clear();
+  /* Chaque garde tient SON registre par fermeture (`const registre = registres.get(name)`) :
+     vider la carte extérieure ne vidait rien de ce que les gardes lisent. On vide chaque registre. */
+  for (const registre of registres.values()) registre.clear();
 }
