 const ID_MAX = 200;
 
+/*
+  CE QU'UN INVITÉ NE LIT PAS (vision cliente, chantier 6).
+
+  Le rôle `guest` existe pour un accès occasionnel et externe — la comptable
+  qui vient chercher les factures, un sous-traitant, une cliente invitée sur
+  son chantier. La simulation du Groupe Vernet a montré qu'une cliente invitée
+  lisait les congés de l'équipe, les candidatures, les formations, les
+  bulletins de paie et les messages privés : tout ce qui n'a aucune raison de
+  sortir de l'entreprise. Ces collections se LISENT VIDES pour un invité (la
+  synchronisation ne casse pas, l'écran est simplement sans rien) et ne
+  s'écrivent pas (403). Les factures, dépenses, projets et tâches restent
+  lisibles : c'est pour eux qu'un invité existe.
+*/
+const MASQUEES_AUX_INVITES = new Set([
+  'leaves',
+  'leaveQuotas',
+  'candidates',
+  'trainings',
+  'certifications',
+  'payslips',
+  'procedures',
+  'dms',
+  'groups',
+  'groupMessages',
+  'announcements',
+  'meetings',
+  'okrs',
+]);
+const estInvite = (req) => req.auth?.role === 'guest';
