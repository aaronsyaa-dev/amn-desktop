+test('un enregistrement supprimé entre-temps : le rejeu le ressuscite ENTIER, sans fusionner avec la pierre tombale', async (t) => {
+  const p = await poste(t);
+  await p.ecrire('t6', { data: TACHE });
+  const depart = await p.lire('t6');
+  await p.supprimer('t6');
+  const rejeu = await p.ecrire('t6', {
+    data: { ...depart.data, status: 'doing' },
+    base: depart.updatedAt,
+    patch: { status: 'doing' },
+  });
+  assert.equal(rejeu.corps.fusion, undefined, 'rien à fusionner avec du vide');
+  const fin = await p.lire('t6');
+  assert.equal(fin.data.title, TACHE.title, 'la fiche revient complète');
+  assert.equal(fin.data.status, 'doing');
+});
+
+test('un patch mal formé (tableau, chaîne) est ignoré : l’écriture passe entière plutôt que d’échouer', async (t) => {
+  const p = await poste(t);
+  await p.ecrire('t7', { data: TACHE });
+  const depart = await p.lire('t7');
+  for (const patch of [['status'], 'status', 42]) {
+    const res = await p.ecrire('t7', { data: { ...depart.data, status: 'doing' }, base: depart.updatedAt, patch });
+    assert.equal(res.statut, 200, `patch ${JSON.stringify(patch)} : la requête aboutit`);
+    assert.equal(res.corps.fusion, undefined);
+  }
+  const fin = await p.lire('t7');
+  assert.equal(fin.data.status, 'doing');
+});
