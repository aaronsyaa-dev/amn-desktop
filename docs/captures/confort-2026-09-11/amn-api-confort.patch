+test('deux modifications du MÊME champ : le dernier arrivé gagne, et lui seul — pas le reste de la fiche', async (t) => {
+  const p = await poste(t);
+  await p.ecrire('t4', { data: TACHE });
+  const depart = await p.lire('t4');
+  // A change le titre ET le statut.
+  await p.ecrire('t4', {
+    data: { ...depart.data, title: 'Titre de A', status: 'doing' },
+    base: depart.updatedAt,
+    patch: { title: 'Titre de A', status: 'doing' },
+  });
+  // B, parti de la même base, ne change que le titre.
+  await p.ecrire('t4', {
+    data: { ...depart.data, title: 'Titre de B' },
+    base: depart.updatedAt,
+    patch: { title: 'Titre de B' },
+  });
+  const fin = await p.lire('t4');
+  assert.equal(fin.data.title, 'Titre de B', 'sur le champ disputé, le dernier arrivé');
+  assert.equal(fin.data.status, 'doing', 'mais le champ que B n’a pas touché garde la valeur de A');
+});
+
+test('trois modifications hors ligne d’affilée : le patch cumulé les porte toutes', async (t) => {
+  const p = await poste(t);
+  await p.ecrire('t5', { data: TACHE });
+  const depart = await p.lire('t5');
+  await p.ecrire('t5', {
+    data: { ...depart.data, assigneeEmail: 'mohamed@amn-test.local' },
+    base: depart.updatedAt,
+    patch: { assigneeEmail: 'mohamed@amn-test.local' },
+  });
+  /*
+    Ce que la file d'envoi du poste envoie après trois gestes hors ligne : UNE
+    entrée, la dernière valeur complète, et le patch cumulé des trois — sur la
+    base d'origine, la seule que le serveur ait jamais eue.
+  */
+  const rejeu = await p.ecrire('t5', {
+    data: { ...depart.data, status: 'doing', priority: 'high', detail: 'vu avec le client' },
+    base: depart.updatedAt,
+    patch: { status: 'doing', priority: 'high', detail: 'vu avec le client' },
+  });
+  const fin = await p.lire('t5');
+  assert.equal(fin.data.status, 'doing');
+  assert.equal(fin.data.priority, 'high');
+  assert.equal(fin.data.detail, 'vu avec le client');
+  assert.equal(fin.data.assigneeEmail, 'mohamed@amn-test.local', 'et l’écriture de l’autre poste tient');
+  assert.equal(rejeu.corps.fusion.cles.length, 3);
+});
