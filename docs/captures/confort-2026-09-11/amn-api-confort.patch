diff --git a/src/lib/activityLabel.js b/src/lib/activityLabel.js
new file mode 100644
index 0000000..402bf2c
--- /dev/null
+++ b/src/lib/activityLabel.js
@@ -0,0 +1,34 @@
+/**
+ * Petits utilitaires partagés par les deux pilotes de base (sqlite.js,
+ * postgres.js) pour le journal d'activité des collections (confort d'usage à
+ * deux — voir docs/confort-usage-quotidien-2026-09-10.md).
+ */
+
+/**
+ * Le champ que le poste appose sur chaque écriture pour dire qui l'a faite
+ * (voir `WRITER_KEY` dans amn-desktop/src/state/SyncContext.tsx). Dupliqué
+ * ici plutôt que partagé entre les deux dépôts : c'est un contrat de trame,
+ * pas un module, et les deux cotés savent déjà lire `_by` chacun de leur
+ * côté (le poste pour son fil d'activité, ici pour le journal).
+ */
+export const WRITER_FIELD = '_by';
+
+/**
+ * Un intitulé lisible au mieux, sans connaître la forme de chaque
+ * collection : une tâche a un `title`, un client un `name`, une facture un
+ * `number`. Rien de trouvé → `null`, affiché comme tel plutôt que deviné.
+ */
+export function bestEffortLabel(data) {
+  if (!data || typeof data !== 'object') return null;
+  for (const champ of ['title', 'name', 'number', 'label']) {
+    const v = data[champ];
+    if (typeof v === 'string' && v.trim()) return v.trim().slice(0, 120);
+  }
+  return null;
+}
+
+/** L'auteur auto-déclaré d'une écriture, s'il est présent et valide. */
+export function actorOf(data) {
+  const v = data?.[WRITER_FIELD];
+  return typeof v === 'string' && v.trim() ? v.trim().toLowerCase() : null;
+}
diff --git a/src/lib/fusion.js b/src/lib/fusion.js
new file mode 100644
index 0000000..e7c78c0
--- /dev/null
+++ b/src/lib/fusion.js
@@ -0,0 +1,117 @@
+/**
+ * LA FUSION D'UNE ÉCRITURE CONCURRENTE — CE QUI DÉCIDE, ET POURQUOI
+ * ════════════════════════════════════════════════════════════════
+ *
+ * ## Le défaut que ce module ferme
+ *
+ * Mesuré à l'audit de fiabilité du 10 septembre 2026, puis rejoué à l'identique
+ * ici (`scripts/check-fusion.mjs`, scénario « le cas central ») :
+ *
+ *   1. une tâche existe ; les deux postes l'ont lue ;
+ *   2. Mohamed perd le réseau et la passe « en cours ». Son écriture attend
+ *      dans la file d'envoi du poste, sous la forme de l'enregistrement ENTIER
+ *      tel qu'il le connaissait ;
+ *   3. pendant ce temps Harun, en ligne, monte la priorité de la même tâche.
+ *      Le serveur accepte ;
+ *   4. Mohamed retrouve le réseau. Sa file rejoue son écriture — bâtie sur une
+ *      version d'avant — et le `PUT` remplace l'enregistrement entier.
+ *
+ * La priorité posée par Harun n'existe alors plus nulle part : ni sur le
+ * serveur, ni sur son écran à la prochaine relecture. Aucun des deux n'est
+ * averti. Ce n'est pas un défaut d'affichage, c'est du travail perdu.
+ *
+ * Le même enchaînement se produit SANS coupure réseau : deux postes qui ont la
+ * même fiche ouverte, l'un change un champ, l'autre en change un autre. Le
+ * second `PUT` porte l'ancienne valeur du premier champ. La coupure ne crée pas
+ * le défaut, elle allonge seulement la fenêtre pendant laquelle il se produit.
+ *
+ * ## Ce qui a été retenu, et ce qui a été écarté
+ *
+ * Deux pistes étaient sur la table.
+ *
+ * **Refuser (409) quand la base a bougé.** Petit changement, mais il transforme
+ * une perte silencieuse en perte annoncée : le poste ne sait rien faire d'un
+ * refus sinon abandonner l'écriture (voir `motsAbandon` côté poste), donc
+ * Mohamed devrait refaire son geste. Surtout, il frapperait le cas le plus
+ * COURANT — deux personnes connectées qui touchent la même fiche à quelques
+ * secondes d'écart, une réaction et une épingle sur le même message — où
+ * pourtant rien ne se contredit. Un refus quotidien sur des gestes qui ne
+ * s'opposent pas, c'est une régression d'usage.
+ *
+ * **Fusionner champ par champ.** C'est ce qui est fait ici. Deux modifications
+ * qui ne portent pas sur le même champ survivent toutes les deux, sans que
+ * personne ait à arbitrer. Il ne reste de conflit vrai que si les deux ont
+ * changé LE MÊME champ — et là, aucune règle automatique ne peut trancher :
+ * c'est le dernier arrivé, comme avant, mais sur ce seul champ.
+ *
+ * La détection, elle, est bien celle de la première piste : le poste dit sur
+ * quelle version il s'est appuyé (`base`). C'est ce qui distingue « personne
+ * n'a bougé » de « quelqu'un a écrit entre-temps » — sans quoi le serveur ne
+ * peut RIEN décider, puisqu'il ne sait pas distinguer un champ que le poste a
+ * délibérément remis à son ancienne valeur d'un champ qu'il n'a jamais touché.
+ *
+ * ## Ce que le serveur ne peut pas savoir, et ne devine donc pas
+ *
+ * La fusion est de PREMIER NIVEAU : un champ change en entier. Un objet
+ * imbriqué (`billTo`) et un tableau (`lines`, `reactions`) sont remplacés d'un
+ * bloc, jamais fusionnés élément par élément. Fusionner deux tableaux demande
+ * de savoir ce qu'est un « même élément », et la réponse dépend du métier :
+ * la deviner ici produirait des lignes de facture en double le jour où deux
+ * postes en ajoutent une chacun.
+ *
+ * Elle ne connaît pas non plus les liens ENTRE champs. Une facture qui s'émet
+ * pose ensemble `status`, `number` et `issuedAt` ; si l'autre poste écrivait au
+ * même moment un `status` périmé, la fusion garderait le numéro et le statut
+ * d'avant. C'est un état incohérent — moins destructeur que l'écrasement total
+ * d'aujourd'hui (qui perdait aussi le numéro), mais incohérent quand même. La
+ * seule vraie réponse serait des groupes de champs atomiques déclarés par
+ * collection ; elle n'est pas dans ce chantier, et elle est écrite ici pour ne
+ * pas être découverte à l'usage.
+ */
+
+/**
+ * Que faire d'une écriture, sachant ce que le serveur détient déjà.
+ *
+ * `courant` est l'enregistrement en base (ou `null`), au format rendu par
+ * `rowToRecord` — c'est-à-dire avec `data` déjà décodé, dans les DEUX pilotes.
+ * C'est ce qui permet à cette décision d'être unique : SQLite et Postgres
+ * appellent la même fonction et ne peuvent donc pas diverger, ce qu'un jour de
+ * maintenance sur l'un des deux seulement finirait sinon par produire.
+ *
+ * Rend `{ data, fusion }` :
+ *   · `data`   — ce qu'il faut écrire, tel quel ;
+ *   · `fusion` — `null` quand l'écriture est passée telle quelle, sinon la
+ *                liste des champs repris du poste et la version qu'il a
+ *                dépassée. La route le renvoie au poste et la trace le dit :
+ *                une fusion silencieuse serait un mensonge par omission.
+ */
+export function deciderEcriture(courant, { data, base, patch }) {
+  // Sans base annoncée, le poste ne dit pas d'où il part : c'est un poste
+  // d'avant ce correctif. On lui garde exactement le comportement qu'il connaît
+  // plutôt que de lui appliquer une règle dont il n'a pas idée.
+  if (!base || !estObjet(patch)) return { data, fusion: null };
+
+  // Rien à fusionner avec ce qui n'existe pas (création), ni avec une pierre
+  // tombale : ressusciter un enregistrement supprimé se fait avec ce que le
+  // poste en sait, pas avec les restes de la version effacée.
+  if (!courant || courant.deleted || !estObjet(courant.data)) return { data, fusion: null };
+
+  // LE CHEMIN NORMAL, et de très loin le plus fréquent : personne n'a écrit
+  // depuis que ce poste a lu. L'enregistrement entier est donc à jour, et il
+  // est écrit tel quel — exactement comme avant ce correctif, au bit près.
+  if (courant.updatedAt === base) return { data, fusion: null };
+
