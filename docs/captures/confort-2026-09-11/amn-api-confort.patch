+
+/**
+ * L'ÉCRASEMENT EN ÉDITION CONCURRENTE — le défaut mesuré à l'audit de
+ * fiabilité du 10 septembre 2026 (scénario S5), et ce qui le ferme.
+ *
+ * Le cas central est celui-là, et il vaut la peine d'être relu chaque fois
+ * qu'on touche à `src/lib/fusion.js` : deux personnes modifient des champs
+ * DIFFÉRENTS de la même fiche, l'une hors ligne. Rien ne se contredit, donc
+ * rien ne doit se perdre — or c'est exactement ce qui se perdait.
+ *
+ * Les tests d'API sont doublés de tests de la décision pure : les premiers
+ * prouvent que la route et la base font ce qu'il faut, les seconds décrivent
+ * la règle elle-même, y compris les cas qu'on ne sait pas atteindre par HTTP
+ * sans écrire un scénario à rallonge.
+ */
+
+async function poste(t) {
+  const db = createSqliteDb(':memory:');
+  await db.init();
+  const app = await createApp({ db });
+  const server = http.createServer(app);
+  await new Promise((resolve) => server.listen(0, resolve));
+  const { port } = server.address();
+  t.after(async () => {
+    server.closeAllConnections?.();
+    await new Promise((resolve) => server.close(resolve));
+    await db.close();
+  });
+  await db.createUser({
+    orgId: AMN_ORG_ID,
+    email: 'aaron@amn-test.local',
+    passwordHash: await hashPassword('motdepasse-solide'),
+    role: 'owner',
+    status: 'active',
+  });
+  const login = await fetch(`http://127.0.0.1:${port}/v1/auth/login`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ email: 'aaron@amn-test.local', password: 'motdepasse-solide' }),
+  });
+  const { token } = await login.json();
+  const base = `http://127.0.0.1:${port}`;
+  const entetes = { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` };
+  return {
+    async ecrire(id, corps) {
+      const res = await fetch(`${base}/v1/collections/tasks/${id}`, {
+        method: 'PUT',
+        headers: entetes,
+        body: JSON.stringify(corps),
+      });
+      return { statut: res.status, corps: await res.json() };
+    },
+    async lire(id) {
+      const res = await fetch(`${base}/v1/collections/tasks`, { headers: entetes });
+      const { records } = await res.json();
+      return records.find((r) => r.id === id) ?? null;
+    },
+    async supprimer(id) {
+      await fetch(`${base}/v1/collections/tasks/${id}`, { method: 'DELETE', headers: entetes });
+    },
+  };
+}
+
+const TACHE = {
+  title: 'Relire le contrat Corvetto',
+  detail: '',
+  status: 'todo',
+  priority: 'normal',
+  assigneeEmail: 'aaron@amn-test.local',
+  siteId: null,
+  clientId: null,
+};
+
+/* ─── Le cas central, celui de l'audit ───────────────────────────────────── */
+
+test('LE CAS DE L’AUDIT : le rejeu d’une écriture hors ligne n’efface plus la modification faite en ligne', async (t) => {
+  const p = await poste(t);
+  await p.ecrire('t1', { data: TACHE });
+  const depart = await p.lire('t1');
+
+  // B part hors ligne avec cette version : il passe la tâche « en cours ».
+  const versionDeB = { ...depart.data, status: 'doing' };
+
+  // A, en ligne, monte la priorité de la même tâche.
+  await p.ecrire('t1', {
+    data: { ...depart.data, priority: 'high' },
+    base: depart.updatedAt,
+    patch: { priority: 'high' },
+  });
+
+  // B revient : sa file rejoue son écriture, bâtie sur la version d'avant.
+  const rejeu = await p.ecrire('t1', {
+    data: versionDeB,
+    base: depart.updatedAt,
+    patch: { status: 'doing' },
+  });
+
+  const fin = await p.lire('t1');
+  assert.equal(fin.data.status, 'doing', 'la modification de B est appliquée');
+  assert.equal(fin.data.priority, 'high', 'la modification de A a SURVÉCU — c’est le défaut qui est fermé');
+  assert.deepEqual(rejeu.corps.fusion?.cles, ['status'], 'le serveur dit ce qu’il a repris de B');
+  assert.equal(rejeu.corps.fusion?.base, depart.updatedAt);
+});
