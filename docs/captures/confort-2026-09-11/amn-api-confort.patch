+test('la décision : sans base, ou sans patch, on écrit ce que le poste envoie', () => {
+  const courant = { data: { a: 1 }, updatedAt: 'T1', deleted: false };
+  assert.deepEqual(deciderEcriture(courant, { data: { a: 2 } }), { data: { a: 2 }, fusion: null });
+  assert.deepEqual(deciderEcriture(courant, { data: { a: 2 }, base: 'T0' }), { data: { a: 2 }, fusion: null });
+});
+
+test('la décision : la base a bougé — on repart du serveur et on ne réapplique que le patch', () => {
+  const courant = { data: { a: 1, b: 'serveur', c: true }, updatedAt: 'T2', deleted: false };
+  const { data, fusion } = deciderEcriture(courant, {
+    data: { a: 9, b: 'périmé', c: true },
+    base: 'T1',
+    patch: { a: 9 },
+  });
+  assert.deepEqual(data, { a: 9, b: 'serveur', c: true }, 'b garde la valeur du serveur, a prend celle du poste');
+  assert.deepEqual(fusion, { cles: ['a'], base: 'T1', depuis: 'T2' });
+});
+
+test('la décision : un patch vide ne change rien du tout, même si la base a bougé', () => {
+  const courant = { data: { a: 1, b: 2 }, updatedAt: 'T2', deleted: false };
+  const { data } = deciderEcriture(courant, { data: { a: 99, b: 99 }, base: 'T1', patch: {} });
+  assert.deepEqual(data, { a: 1, b: 2 }, 'le poste n’a rien changé : rien ne bouge');
+});
+
+test('la décision : une pierre tombale ou une création ne fusionnent jamais', () => {
+  const tombale = { data: {}, updatedAt: 'T2', deleted: true };
+  assert.deepEqual(deciderEcriture(tombale, { data: { a: 1 }, base: 'T1', patch: { a: 1 } }), {
+    data: { a: 1 },
+    fusion: null,
+  });
+  assert.deepEqual(deciderEcriture(null, { data: { a: 1 }, base: 'T1', patch: { a: 1 } }), {
+    data: { a: 1 },
+    fusion: null,
+  });
+});
