@@ -0,0 +1,257 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import http from 'node:http';
+
+process.env.NODE_ENV = 'test';
+process.env.OPERATOR_TOKEN = 'test-operator-token';
+
+const { createApp } = await import('../src/server.js');
+const { createSqliteDb } = await import('../src/db/sqlite.js');
+const { AMN_ORG_ID } = await import('../src/db/tenancy.js');
+const { hashPassword } = await import('../src/lib/password.js');
+const { deciderEcriture } = await import('../src/lib/fusion.js');
+
+/**
+ * L'ÉCRASEMENT EN ÉDITION CONCURRENTE — le défaut mesuré à l'audit de
+ * fiabilité du 10 septembre 2026 (scénario S5), et ce qui le ferme.
+ *
+ * Le cas central est celui-là, et il vaut la peine d'être relu chaque fois
+ * qu'on touche à `src/lib/fusion.js` : deux personnes modifient des champs
+ * DIFFÉRENTS de la même fiche, l'une hors ligne. Rien ne se contredit, donc
+ * rien ne doit se perdre — or c'est exactement ce qui se perdait.
+ *
+ * Les tests d'API sont doublés de tests de la décision pure : les premiers
+ * prouvent que la route et la base font ce qu'il faut, les seconds décrivent
+ * la règle elle-même, y compris les cas qu'on ne sait pas atteindre par HTTP
+ * sans écrire un scénario à rallonge.
+ */
+
+async function poste(t) {
+  const db = createSqliteDb(':memory:');
+  await db.init();
+  const app = await createApp({ db });
+  const server = http.createServer(app);
+  await new Promise((resolve) => server.listen(0, resolve));
+  const { port } = server.address();
+  t.after(async () => {
+    server.closeAllConnections?.();
+    await new Promise((resolve) => server.close(resolve));
+    await db.close();
+  });
+  await db.createUser({
+    orgId: AMN_ORG_ID,
+    email: 'aaron@amn-test.local',
+    passwordHash: await hashPassword('motdepasse-solide'),
+    role: 'owner',
+    status: 'active',
+  });
+  const login = await fetch(`http://127.0.0.1:${port}/v1/auth/login`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ email: 'aaron@amn-test.local', password: 'motdepasse-solide' }),
+  });
+  const { token } = await login.json();
+  const base = `http://127.0.0.1:${port}`;
+  const entetes = { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` };
+  return {
+    async ecrire(id, corps) {
+      const res = await fetch(`${base}/v1/collections/tasks/${id}`, {
+        method: 'PUT',
+        headers: entetes,
+        body: JSON.stringify(corps),
+      });
+      return { statut: res.status, corps: await res.json() };
+    },
+    async lire(id) {
+      const res = await fetch(`${base}/v1/collections/tasks`, { headers: entetes });
+      const { records } = await res.json();
+      return records.find((r) => r.id === id) ?? null;
+    },
+    async supprimer(id) {
+      await fetch(`${base}/v1/collections/tasks/${id}`, { method: 'DELETE', headers: entetes });
+    },
+  };
+}
+
+const TACHE = {
+  title: 'Relire le contrat Corvetto',
+  detail: '',
+  status: 'todo',
+  priority: 'normal',
+  assigneeEmail: 'aaron@amn-test.local',
+  siteId: null,
+  clientId: null,
+};
+
+/* ─── Le cas central, celui de l'audit ───────────────────────────────────── */
+
+test('LE CAS DE L’AUDIT : le rejeu d’une écriture hors ligne n’efface plus la modification faite en ligne', async (t) => {
+  const p = await poste(t);
+  await p.ecrire('t1', { data: TACHE });
+  const depart = await p.lire('t1');
+
+  // B part hors ligne avec cette version : il passe la tâche « en cours ».
+  const versionDeB = { ...depart.data, status: 'doing' };
+
+  // A, en ligne, monte la priorité de la même tâche.
+  await p.ecrire('t1', {
+    data: { ...depart.data, priority: 'high' },
+    base: depart.updatedAt,
+    patch: { priority: 'high' },
+  });
+
+  // B revient : sa file rejoue son écriture, bâtie sur la version d'avant.
+  const rejeu = await p.ecrire('t1', {
+    data: versionDeB,
+    base: depart.updatedAt,
+    patch: { status: 'doing' },
+  });
+
+  const fin = await p.lire('t1');
+  assert.equal(fin.data.status, 'doing', 'la modification de B est appliquée');
+  assert.equal(fin.data.priority, 'high', 'la modification de A a SURVÉCU — c’est le défaut qui est fermé');
+  assert.deepEqual(rejeu.corps.fusion?.cles, ['status'], 'le serveur dit ce qu’il a repris de B');
+  assert.equal(rejeu.corps.fusion?.base, depart.updatedAt);
+});
+
+test('sans base annoncée, le comportement d’avant est conservé au bit près (poste non mis à jour)', async (t) => {
+  const p = await poste(t);
+  await p.ecrire('t2', { data: TACHE });
+  const depart = await p.lire('t2');
+  await p.ecrire('t2', { data: { ...depart.data, priority: 'high' } });
+  // Un poste d'avant ce correctif : il envoie l'enregistrement entier, sans base.
+  const rejeu = await p.ecrire('t2', { data: { ...depart.data, status: 'doing' } });
+  const fin = await p.lire('t2');
+  assert.equal(fin.data.status, 'doing');
+  assert.equal(fin.data.priority, 'normal', 'il écrase, comme il l’a toujours fait');
+  assert.equal(rejeu.corps.fusion, undefined, 'et aucune fusion n’est annoncée');
+});
+
+test('quand personne n’a bougé, l’enregistrement entier passe tel quel — le chemin normal', async (t) => {
+  const p = await poste(t);
+  await p.ecrire('t3', { data: TACHE });
+  const depart = await p.lire('t3');
+  const res = await p.ecrire('t3', {
+    data: { ...depart.data, title: 'Relire le contrat Corvetto (relu)' },
+    base: depart.updatedAt,
+    patch: { title: 'Relire le contrat Corvetto (relu)' },
+  });
+  assert.equal(res.corps.fusion, undefined, 'aucune fusion : la base n’avait pas bougé');
+  const fin = await p.lire('t3');
+  assert.equal(fin.data.title, 'Relire le contrat Corvetto (relu)');
+  assert.equal(fin.data.status, 'todo');
+});
+
+test('deux modifications du MÊME champ : le dernier arrivé gagne, et lui seul — pas le reste de la fiche', async (t) => {
+  const p = await poste(t);
+  await p.ecrire('t4', { data: TACHE });
+  const depart = await p.lire('t4');
+  // A change le titre ET le statut.
+  await p.ecrire('t4', {
+    data: { ...depart.data, title: 'Titre de A', status: 'doing' },
+    base: depart.updatedAt,
+    patch: { title: 'Titre de A', status: 'doing' },
+  });
+  // B, parti de la même base, ne change que le titre.
+  await p.ecrire('t4', {
+    data: { ...depart.data, title: 'Titre de B' },
+    base: depart.updatedAt,
+    patch: { title: 'Titre de B' },
+  });
+  const fin = await p.lire('t4');
+  assert.equal(fin.data.title, 'Titre de B', 'sur le champ disputé, le dernier arrivé');
+  assert.equal(fin.data.status, 'doing', 'mais le champ que B n’a pas touché garde la valeur de A');
+});
+
+test('trois modifications hors ligne d’affilée : le patch cumulé les porte toutes', async (t) => {
+  const p = await poste(t);
+  await p.ecrire('t5', { data: TACHE });
+  const depart = await p.lire('t5');
+  await p.ecrire('t5', {
+    data: { ...depart.data, assigneeEmail: 'mohamed@amn-test.local' },
+    base: depart.updatedAt,
+    patch: { assigneeEmail: 'mohamed@amn-test.local' },
+  });
+  /*
+    Ce que la file d'envoi du poste envoie après trois gestes hors ligne : UNE
+    entrée, la dernière valeur complète, et le patch cumulé des trois — sur la
+    base d'origine, la seule que le serveur ait jamais eue.
+  */
+  const rejeu = await p.ecrire('t5', {
+    data: { ...depart.data, status: 'doing', priority: 'high', detail: 'vu avec le client' },
+    base: depart.updatedAt,
+    patch: { status: 'doing', priority: 'high', detail: 'vu avec le client' },
+  });
+  const fin = await p.lire('t5');
+  assert.equal(fin.data.status, 'doing');
+  assert.equal(fin.data.priority, 'high');
+  assert.equal(fin.data.detail, 'vu avec le client');
+  assert.equal(fin.data.assigneeEmail, 'mohamed@amn-test.local', 'et l’écriture de l’autre poste tient');
+  assert.equal(rejeu.corps.fusion.cles.length, 3);
+});
+
+test('un enregistrement supprimé entre-temps : le rejeu le ressuscite ENTIER, sans fusionner avec la pierre tombale', async (t) => {
+  const p = await poste(t);
+  await p.ecrire('t6', { data: TACHE });
+  const depart = await p.lire('t6');
+  await p.supprimer('t6');
+  const rejeu = await p.ecrire('t6', {
+    data: { ...depart.data, status: 'doing' },
+    base: depart.updatedAt,
+    patch: { status: 'doing' },
+  });
+  assert.equal(rejeu.corps.fusion, undefined, 'rien à fusionner avec du vide');
+  const fin = await p.lire('t6');
+  assert.equal(fin.data.title, TACHE.title, 'la fiche revient complète');
+  assert.equal(fin.data.status, 'doing');
+});
+
+test('un patch mal formé (tableau, chaîne) est ignoré : l’écriture passe entière plutôt que d’échouer', async (t) => {
+  const p = await poste(t);
+  await p.ecrire('t7', { data: TACHE });
+  const depart = await p.lire('t7');
+  for (const patch of [['status'], 'status', 42]) {
+    const res = await p.ecrire('t7', { data: { ...depart.data, status: 'doing' }, base: depart.updatedAt, patch });
+    assert.equal(res.statut, 200, `patch ${JSON.stringify(patch)} : la requête aboutit`);
+    assert.equal(res.corps.fusion, undefined);
+  }
+  const fin = await p.lire('t7');
+  assert.equal(fin.data.status, 'doing');
+});
+
+/* ─── La règle elle-même, sans HTTP ni base ──────────────────────────────── */
+
+test('la décision : sans base, ou sans patch, on écrit ce que le poste envoie', () => {
+  const courant = { data: { a: 1 }, updatedAt: 'T1', deleted: false };
+  assert.deepEqual(deciderEcriture(courant, { data: { a: 2 } }), { data: { a: 2 }, fusion: null });
+  assert.deepEqual(deciderEcriture(courant, { data: { a: 2 }, base: 'T0' }), { data: { a: 2 }, fusion: null });
+});
+
+test('la décision : la base a bougé — on repart du serveur et on ne réapplique que le patch', () => {
+  const courant = { data: { a: 1, b: 'serveur', c: true }, updatedAt: 'T2', deleted: false };
+  const { data, fusion } = deciderEcriture(courant, {
+    data: { a: 9, b: 'périmé', c: true },
+    base: 'T1',
+    patch: { a: 9 },
+  });
+  assert.deepEqual(data, { a: 9, b: 'serveur', c: true }, 'b garde la valeur du serveur, a prend celle du poste');
+  assert.deepEqual(fusion, { cles: ['a'], base: 'T1', depuis: 'T2' });
+});
+
+test('la décision : un patch vide ne change rien du tout, même si la base a bougé', () => {
+  const courant = { data: { a: 1, b: 2 }, updatedAt: 'T2', deleted: false };
+  const { data } = deciderEcriture(courant, { data: { a: 99, b: 99 }, base: 'T1', patch: {} });
+  assert.deepEqual(data, { a: 1, b: 2 }, 'le poste n’a rien changé : rien ne bouge');
+});
+
+test('la décision : une pierre tombale ou une création ne fusionnent jamais', () => {
+  const tombale = { data: {}, updatedAt: 'T2', deleted: true };
+  assert.deepEqual(deciderEcriture(tombale, { data: { a: 1 }, base: 'T1', patch: { a: 1 } }), {
+    data: { a: 1 },
+    fusion: null,
+  });
+  assert.deepEqual(deciderEcriture(null, { data: { a: 1 }, base: 'T1', patch: { a: 1 } }), {
+    data: { a: 1 },
+    fusion: null,
+  });
+});
