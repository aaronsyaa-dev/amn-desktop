{
  "name": "amn-desktop",
  "productName": "AMN Desktop",
  "version": "1.2.13",
  "description": "AMN Desktop - Electron + React application for monitoring sites",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "bootstrap": "npm rebuild esbuild electron-winstaller fsevents",
    "start": "npm run bootstrap && electron-forge start",
    "package": "npm run bootstrap && electron-forge package",
    "make": "npm run bootstrap && electron-forge make",
    "publish": "npm run bootstrap && electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit",
    "build:web": "node scripts/build-web.mjs",
    "check:sync": "node scripts/check-sync-parity.mjs",
    "typecheck:business": "tsc --noEmit -p tsconfig.business.json",
    "start:business": "cross-env AMN_EDITION=business npm run start",
    "package:business": "cross-env AMN_EDITION=business npm run package",
    "make:business": "cross-env AMN_EDITION=business npm run make",
    "build:web:business": "cross-env AMN_EDITION=business node scripts/build-web.mjs",
    "check:business": "node scripts/check-business-bundle.mjs",
    "check:deployed": "node scripts/check-deployed-bundle.mjs"
  },
  "keywords": [],
  "author": {
    "name": "AMN"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^7.0.3",
    "electron": "43.2.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.1",
    "dotenv": "^17.4.2",
    "electron-squirrel-startup": "^1.0.1",
    "koffi": "^3.1.4",
    "update-electron-app": "^3.3.0",
    "ws": "^8.21.1"
  }
}
