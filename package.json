{
  "name": "amn-desktop",
  "productName": "AMN Business",
  "version": "1.2.42",
  "description": "AMN Desktop - Electron + React application for monitoring sites",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "bootstrap": "npm rebuild esbuild electron-winstaller fsevents",
    "start": "npm run bootstrap && electron-forge start",
    "build:desktop": "node scripts/build-desktop.mjs",
    "package": "npm run bootstrap && npm run build:desktop && electron-builder --config electron-builder.config.mjs --dir",
    "make": "npm run bootstrap && npm run build:desktop && electron-builder --config electron-builder.config.mjs",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit",
    "build:web": "node scripts/build-web.mjs",
    "check:sync": "node scripts/check-sync-parity.mjs",
    "check:supervision": "node scripts/check-supervision.mjs",
    "check:journal": "node scripts/check-journal.mjs",
    "check:justificatif": "node scripts/check-justificatif.mjs",
    "check:ecrans": "node scripts/check-ecrans.mjs",
    "typecheck:business": "tsc --noEmit -p tsconfig.business.json",
    "start:business": "cross-env AMN_EDITION=business npm run start",
    "package:business": "cross-env AMN_EDITION=business npm run package",
    "make:business": "cross-env AMN_EDITION=business npm run make",
    "build:web:business": "cross-env AMN_EDITION=business node scripts/build-web.mjs",
    "check:business": "node scripts/check-business-bundle.mjs",
    "check:modules": "node scripts/check-modules.mjs",
    "check:roles": "node scripts/check-roles.mjs",
    "check:naming": "node scripts/check-naming.mjs",
    "check:signing": "node scripts/check-signing.mjs",
    "check:profiles": "node scripts/check-profiles.mjs",
    "check:persistence": "node scripts/check-persistence.mjs",
    "check:accent": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-accent.ts",
    "check:money": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-money.ts",
    "check:sauvegarde": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-sauvegarde.ts",
    "check:calc": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-calc.ts",
    "check:evenements": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-evenements.ts",
    "check:trend": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-trend.ts",
    "check:messages": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-messages.ts",
    "check:pages": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-pages.ts",
    "check:resilience": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-resilience.ts",
    "check:attention": "cross-env TZ=Europe/Paris node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-attention.ts",
    "check:fec": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-fec.ts",
    "check:tracking": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-tracking.ts",
    "check:envoi": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-envoi.ts",
    "check:barre": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-barre.ts",
    "check:graphe": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-graphe.ts",
    "check:langue": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-langue.ts",
    "check:releve": "cross-env TZ=Europe/Paris node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-releve.ts",
    "check:vitaux": "cross-env TZ=Europe/Paris node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-vitaux.ts",
    "check:liens": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-liens.ts",
    "check:calques": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-calques.ts",
    "check:clavier": "node scripts/check-clavier.mjs",
    "gardes": "node scripts/gardes-navigateur.mjs",
    "seed:essai": "node scripts/seed-essai.mjs",
    "check:etiquettes": "node scripts/check-etiquettes.mjs",
    "check:focus": "node scripts/check-focus.mjs",
    "check:cibles": "node scripts/check-cibles.mjs",
    "check:contraste": "node scripts/check-contraste.mjs",
    "check:mouvement": "node scripts/check-mouvement.mjs",
    "check:largeur": "node scripts/check-largeur.mjs",
    "check:deployed": "node scripts/check-deployed-bundle.mjs",
    "publish:release": "node scripts/publish-release.mjs",
    "check:updates": "node scripts/check-update-channel.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:installer": "node scripts/check-installer.mjs",
    "icons": "node scripts/build-icons.mjs"
  },
  "keywords": [],
  "author": {
    "name": "AMN"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^7.0.3",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "koffi": "^3.1.4",
    "ws": "^8.21.1"
  }
}
